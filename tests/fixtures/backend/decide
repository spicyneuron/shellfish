#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail

typeset request
request=$(cat)
[[ -z ${SF_TEST_BACKEND_REQUEST-} ]] || print -r -- "$request" >"$SF_TEST_BACKEND_REQUEST"
case ${SF_TEST_DECIDE-} in
  error) print -u2 -r -- 'test decision failure'; exit 7 ;;
  invalid) print -r -- '{"model":"fake","answers":{}}'; exit ;;
esac
# Refuse on "refuse"; otherwise pick the first choice and the second level.
jq -c '
  {model:.request.model, answers:(.questions | map_values(
    if .instructions == "refuse" then {type:"refusal"}
    elif .type == "predicate" then {type, probability:0.75}
    elif .type == "choice" then (.choices | keys_unsorted[0]) as $first |
      {type, choice:$first, confidence:1,
       probabilities:(.choices | with_entries(.value = if .key == $first then 1 else 0 end))}
    else {type, score:1, confidence:1,
      probabilities:[.levels | keys[] | if . == 1 then 1 else 0 end]} end)),
   usage:{input_tokens:(tojson | length / 4 | floor), output_tokens:0}}
' <<<"$request"

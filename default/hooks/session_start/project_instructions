#!/usr/bin/env zsh

set -u

[ "$#" -eq 1 ] && [ "$1" = session_start ] || exit 1

for name in AGENTS.md CLAUDE.md; do
  [ -f "$name" ] && [ -r "$name" ] || continue
  printf '%s: Follow the instructions below for this directory tree. ' "$name"
  printf 'Do not reread this file. A nested %s takes precedence.\n\n' "$name"
  cat "$name" || exit 1
  exit 0
done

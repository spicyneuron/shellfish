#!/usr/bin/env zsh

set -u
unsetopt BG_NICE
zmodload zsh/datetime
zmodload zsh/zselect

[ "$#" -eq 1 ] && [ "$1" = session_start ] || exit 1

printf 'Date: %s\n' "$(date '+%Y-%m-%d')"
printf 'Platform: %s %s\n\n' "$(uname -s)" "$(uname -r)"
printf 'PWD: %s\n' "$(pwd -P)"

typeset -F deadline=$(( EPOCHREALTIME + 1 ))
capped() {
  local pid timer
  typeset -i exit_code=0 ticks=$(( (deadline - EPOCHREALTIME) * 100 ))
  (( ticks > 0 )) || return 124
  "$@" &
  pid=$!
  (
    zselect -t "$ticks" || true
    kill -TERM "$pid" 2>/dev/null || true
  ) </dev/null >/dev/null 2>&1 &
  timer=$!
  wait "$pid" || exit_code=$?
  kill -TERM "$timer" 2>/dev/null || true
  wait "$timer" 2>/dev/null || true
  (( exit_code == 143 )) && return 124
  return "$exit_code"
}

exit_if_slow() {
  (( $1 == 124 )) || return 0
  printf '\n%s: %s\n' "$2" '(skipped, slow file system)'
  exit 0
}

typeset -a directory_command
if (( $+commands[tree] )); then
  directory_command=(tree -L 2 --gitignore --dirsfirst -F --noreport --prune \
    --condense --compress 3 --filelimit 25)
else
  directory_command=(ls -F)
fi

typeset output
typeset -i probe_status
output=$(capped "${directory_command[@]}" 2>&1)
probe_status=$?
exit_if_slow "$probe_status" 'Filesystem context'
if (( $+commands[tree] )) &&
    { (( probe_status != 0 )) || [[ $output == *'[error opening dir]'* ]]; }; then
  output=$(capped ls -F 2>&1)
  probe_status=$?
  exit_if_slow "$probe_status" 'Filesystem context'
fi
printf '%s\n' "$(print -r -- "$output" | head -100)"

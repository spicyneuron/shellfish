#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_bg_nice no_multios pipe_fail
zmodload zsh/datetime
zmodload zsh/zselect

[[ $# == 1 && $1 == user_prompt_submit ]] || exit 1

state="$SHELLFISH_SESSION_STATE/git_awareness"
[[ -f $state ]] || exit 0
previous=$(<$state) || exit 0
temp="$state.$$"
typeset -F deadline=$(( EPOCHREALTIME + 1 ))

capped() {
  local pid timer
  integer exit_code=0 ticks=$(( (deadline - EPOCHREALTIME) * 100 ))
  (( ticks > 0 )) || return 124
  "$@" &
  pid=$!
  (
    zselect -t "$ticks" || true
    kill -TERM "$pid" 2>/dev/null || true
  ) </dev/null >/dev/null 2>&1 &
  timer=$!
  wait "$pid" || exit_code=$?
  kill -TERM "$timer" 2>/dev/null || true
  wait "$timer" 2>/dev/null || true
  (( exit_code == 143 )) && return 124
  return "$exit_code"
}

cleanup() {
  rm -f -- "$temp"
}
trap cleanup EXIT INT TERM

typeset branch hash identity
branch=$(capped git symbolic-ref --quiet --short HEAD 2>/dev/null)
case $? in
  0) identity="branch:$branch" ;;
  1)
    hash=$(capped git rev-parse --verify HEAD 2>/dev/null) || exit 0
    identity="commit:$hash"
    ;;
  *) exit 0 ;;
esac
[[ $identity != "$previous" ]] || exit 0

print -r -- "$identity" >"$temp" && mv -f -- "$temp" "$state" || exit 1
case "$previous -> $identity" in
  branch:*' -> branch:'*)
    print -r -- "Git branch changed from ${previous#branch:} to ${identity#branch:}."
    ;;
  *)
    print -r -- "Git identity changed from $previous to $identity."
    ;;
esac
exit 0

#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_bg_nice no_multios pipe_fail
zmodload zsh/datetime
source "${0:A:h:h:h}/lib/capped.zsh" || exit 1

state="$SHELLFISH_SESSION_STATE/git_awareness"
[[ -f $state ]] || exit 0
previous=$(<$state) || exit 0
temp="$state.$$"
typeset -F deadline=$(( EPOCHREALTIME + 1 ))

cleanup() {
  rm -f -- "$temp"
}
trap cleanup EXIT INT TERM

typeset branch hash identity
branch=$(sf_capped "$deadline" git symbolic-ref --quiet --short HEAD 2>/dev/null)
case $? in
  0) identity="branch:$branch" ;;
  1)
    hash=$(sf_capped "$deadline" git rev-parse --verify HEAD 2>/dev/null) || exit 0
    identity="commit:$hash"
    ;;
  *) exit 0 ;;
esac
[[ $identity != "$previous" ]] || exit 0

print -r -- "$identity" >"$temp" && mv -f -- "$temp" "$state" || exit 1
case "$previous -> $identity" in
  branch:*' -> branch:'*)
    print -r -- "Git branch changed from ${previous#branch:} to ${identity#branch:}."
    ;;
  *)
    print -r -- "Git identity changed from $previous to $identity."
    ;;
esac
exit 0

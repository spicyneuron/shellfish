#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset submitted draft='' instruction request summary created base candidate
typeset -a argv
integer explicit=0 suffix=1

fail_compaction() {
  print -u2 -r -- "$1"
  (( explicit )) && return 10
  return 0
}

submitted=$(cat; printf x)
submitted=${submitted%x}

case $submitted in
  /help|/h)
    print -r -- $'113\t/compact\tSummarize this session into a new one' \
      >>"$SHELLFISH_TURN_STATE/help.tsv"
    exit 0
    ;;
  /compact)
    explicit=1
    jq -es 'any(.[]; .type == "message")' "$SHELLFISH_SESSION" >/dev/null 2>&1 || {
      print -u2 -r -- 'nothing to compact yet'
      exit 10
    }
    ;;
  *)
    # Automatic compaction uses the most recent measured response only after a
    # complete assistant turn.
    jq -es '
      .[0].profile.context_window as $window |
      [.[] | select(.type == "message" and .role == "assistant")] as $assistants |
      ($assistants | map(select(.usage != null)) | last) as $measured |
      $window != null and $measured != null and
      $assistants[-1].stop != "tool_calls" and
      (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
    ' "$SHELLFISH_SESSION" >/dev/null 2>&1 || exit 0
    draft=$submitted
    ;;
esac

instruction=$'Create a concise continuation summary of this conversation. Preserve key decisions, requirements, completed work, unresolved work, and technical details needed to continue. Return only the summary. Do not address the user or take actions.'
request=$(jq -cn --arg text "$instruction" \
  '{type:"message",role:"user",content:[{type:"text",text:$text}]}') || {
  fail_compaction 'cannot prepare summary request; keeping the original'
  exit $?
}
summary=$(print -r -- "$request" |
  "$SHELLFISH_EXECUTABLE" build-request --session "$SHELLFISH_SESSION" --tools '[]' |
  "$SHELLFISH_EXECUTABLE" run-request --session "$SHELLFISH_SESSION" |
  jq -er '[.content[] | select(.type == "text") | .text] | join("") |
    select(test("[^[:space:]]"))') || {
  fail_compaction 'cannot summarize session; keeping the original'
  exit $?
}

base=${SHELLFISH_SESSION%.jsonl}
base=${base%_compact(|_<->)}
candidate="${base}_compact.jsonl"
umask 077
while ! (setopt no_clobber; : >"$candidate") 2>/dev/null; do
  if [[ ! -e $candidate && ! -L $candidate ]]; then
    fail_compaction 'cannot create compacted session; keeping the original'
    exit $?
  fi
  candidate="${base}_compact_${suffix}.jsonl"
  (( suffix++ ))
done

created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || {
  rm -f -- "$candidate"
  fail_compaction 'cannot create compacted session; keeping the original'
  exit $?
}
if ! jq -ce -s --rawfile summary <(print -rn -- "$summary") --arg created "$created" '
    ([to_entries[] | select(.value.type == "message") | .key] | first) as $start |
    select($start != null) |
    (.[0:$start] | .[0].created = $created)[],
    {type:"context",hook:"compact",script:"compact",content:$summary}
  ' "$SHELLFISH_SESSION" >"$candidate" || ! chmod 600 "$candidate"; then
  rm -f -- "$candidate"
  fail_compaction 'cannot create compacted session; keeping the original'
  exit $?
fi

argv=( "$SHELLFISH_EXECUTABLE" --session "$candidate" )
[[ -z $draft ]] || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || {
  rm -f -- "$candidate"
  exit 1
}
exit 11

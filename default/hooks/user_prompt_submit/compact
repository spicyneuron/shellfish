#!/usr/bin/env zsh

# Compaction policy. As a user_prompt_submit hook it recognizes /compact and
# detects a session near its context window, then hands off to itself. The
# handoff runs in the client's environment, where provider credentials are
# still resolvable and the source session lock has been released.

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

if [[ $1 != user_prompt_submit ]]; then
  typeset executable=$1 source=$2 draft=${3-}
  typeset summary='' created base candidate='' temp
  typeset instruction=$'Create a concise continuation summary of this conversation. Preserve key decisions, requirements, completed work, unresolved work, and technical details needed to continue. Return only the summary. Do not address the user or take actions.'
  integer suffix=1 published=0

  open_session() {
    local -a open=( "$executable" --session "$1" )
    [[ -z $draft ]] || open+=( --draft "$draft" )
    exec -- "${open[@]}"
  }

  summary=$("$executable" exec --session "$source" --no-save --no-hooks "$instruction" \
    </dev/null) && [[ $summary == *[^[:space:]]* ]] || {
    print -u2 -r -- 'cannot summarize session; keeping the original'
    open_session "$source"
  }

  base=${source%.jsonl}
  base=${base%_compact(|_<->)}
  created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') &&
    temp=$(mktemp "${source:h}/.${source:t}.compact.XXXXXX") || {
    print -u2 -r -- 'cannot prepare compacted session; keeping the original'
    open_session "$source"
  }
  {
    repeat 1; do
      chmod 600 "$temp" || break
      # The summarizing turn already validated the source, and any string is
      # valid context content, so a slice plus the summary is a valid child.
      jq -ce -s --rawfile summary <(print -rn -- "$summary") --arg created "$created" '
        ([to_entries[] | select(.value.type == "message") | .key] | first) as $start |
        select($start != null) |
        (.[0:$start] | .[0].created = $created)[],
        {type:"context",hook:"compact",script:"compact",content:$summary}
      ' "$source" >"$temp" || break
      candidate="${base}_compact.jsonl"
      while ! ln "$temp" "$candidate" 2>/dev/null; do
        [[ -e $candidate || -L $candidate ]] || break 2
        candidate="${base}_compact_${suffix}.jsonl"
        (( suffix++ ))
      done
      published=1
    done
  } always {
    rm -f -- "$temp" 2>/dev/null || true
  }
  (( published )) || {
    print -u2 -r -- 'cannot create compacted session; keeping the original'
    open_session "$source"
  }
  open_session "$candidate"
fi

typeset submitted draft=''
submitted=$(cat; printf x)
submitted=${submitted%x}

case $submitted in
  /help|/h)
    print -r -- $'113\t/compact\tSummarize this session into a new one' \
      >>"$SHELLFISH_TURN_STATE/help.tsv"
    exit 0
    ;;
  /compact)
    jq -es 'any(.[]; .type == "message")' "$SHELLFISH_SESSION" >/dev/null 2>&1 || {
      print -u2 -r -- 'nothing to compact yet'
      exit 10
    }
    ;;
  *)
    # An ordinary prompt compacts only once the most recent measured response
    # reaches 80% of the frozen context window.
    jq -es '
      .[0].profile.context_window as $window |
      [.[] | select(.type == "message" and .role == "assistant")] as $assistants |
      ($assistants | map(select(.usage != null)) | last) as $measured |
      $window != null and $measured != null and
      $assistants[-1].stop != "tool_calls" and
      (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
    ' "$SHELLFISH_SESSION" >/dev/null 2>&1 || exit 0
    draft=$submitted
    ;;
esac

jq -cn --arg script "${0:A}" --arg command "$SHELLFISH_EXECUTABLE" \
  --arg source "$SHELLFISH_SESSION" --arg draft "$draft" '
  {action:"handoff",argv:[$script,$command,$source,$draft]}
' >&3 || exit 1
exit 11

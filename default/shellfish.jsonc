// Shellfish: https://github.com/spicyneuron/shellfish
//
// Default configuration. $XDG_CONFIG_HOME/shellfish/shellfish.jsonc is merged over
// this file.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/shellfish.schema.json",

  // Profile selected when --profile is not given on the command line.
  "default_profile": "default",

  // Profiles compose a backend, a harness, and request overrides. "extend"
  // inherits from another profile and later keys override. "request" holds
  // model and other parameters passed through to backend adapters. "max_tokens"
  // and "reasoning.effort" are normalized in default backends.
  "profiles": {
    "default": {
      "harness": "default",
      "request": {"max_tokens": 16384, "reasoning": {"effort": "medium"}}
    }
  },

  // Backends are API adapters. "adapter" names the run script under
  // backends/<adapter>/; "endpoint" and "api_key_env" override the adapter's
  // built-in backend.json. An empty api_key_env means no key is sent (codex
  // relies on an existing CLI login). The "openai" adapter works with any
  // OpenAI-compatible endpoint. Optional transport knobs not shown here:
  // insecure_tls, http_timeout, http_stall.
  "backends": {
    "anthropic": {"adapter": "anthropic"},
    "codex": {"adapter": "codex"},
    "openai": {"adapter": "openai"},
    "openai-responses": {"adapter": "openai-responses"},
    "openrouter": {
      "adapter": "openai",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_API_KEY"
    }
  },

  // Harnesses wrap the shared turn loop with context, capabilities, sandboxing,
  // and limits.
  "harnesses": {
    "default": {
      // Static files and scripts concatenated into the system prompt.
      "system": ["general.md", "tools.md"],

      // Tools available to the model.
      "tools": ["read_file", "edit_file", "write_file", "skill", "search_web", "fetch_url", "shell"],

      // Each hook runs an ordered list of components. See docs/HOOKS.md for
      // payloads, exit statuses, and environment guarantees.
      "session_start": ["project_environment", "git_awareness", "shell_commands", "skills", "project_instructions"],
      "user_prompt_submit": ["refresh", "verbose", "new", "copy", "fork", "sandbox", "user_shell", "server", "resume", "help", "git_awareness"],
      "permission_request": [],
      "pre_tool_use": [],
      "post_tool_use": [],
      "stop": [],

      // "sandbox" enables fence for tools that opt in via their tool.json.
      // sandbox_read_paths/sandbox_write_paths grant extra paths beyond the
      // project directory while keeping the tool's other restrictions.
      "sandbox": true,
      "sandbox_read_paths": [],
      "sandbox_write_paths": [],

      // Caps for requests, tool calls, and bytes from a single tool result.
      "max_requests_per_turn": 100,
      "max_tool_calls_per_request": 25,
      "max_capture_bytes": 32768
    }
  },

  // Themes are hex color palettes for the TUI. "auto" follows the terminal
  // background; "light"/"dark" force a mode. theme_light/theme_dark name which
  // entry under "themes" is used for each mode.
  "theme_mode": "auto",
  "theme_light": "light",
  "theme_dark": "dark",
  "themes": {
    "light": {
      "muted": "#828e9f",
      "divider": "#d6dde3",
      "footer": "#828e9f",
      "prompt": "#399ee6",
      "system_heading": "#a37acc",
      "context": "#828e9f",
      "user_heading": "#399ee6",
      "agent_heading": "#fa8d3e",
      "tool": "#828e9f",
      "reasoning": "#828e9f",
      "error": "#e65050",
      "syntax_comment": "#828e9f",
      "syntax_keyword": "#fa8d3e",
      "syntax_string": "#86b300",
      "syntax_number": "#a37acc",
      "syntax_tag": "#55b4d4",
      "diff_added": "#3f7f34",
      "diff_added_background": "#e2f4df",
      "diff_removed": "#b84f5b",
      "diff_removed_background": "#f8e1e3",
      "permission": "#399ee6"
    },
    "dark": {
      "muted": "#707a8c",
      "divider": "#3d444d",
      "footer": "#707a8c",
      "prompt": "#73d0ff",
      "system_heading": "#dfbfff",
      "context": "#707a8c",
      "user_heading": "#73d0ff",
      "agent_heading": "#ffa759",
      "tool": "#707a8c",
      "reasoning": "#707a8c",
      "error": "#ff6666",
      "syntax_comment": "#707a8c",
      "syntax_keyword": "#ffa759",
      "syntax_string": "#d5ff80",
      "syntax_number": "#dfbfff",
      "syntax_tag": "#5ccfe6",
      "diff_added": "#87d96c",
      "diff_added_background": "#12261e",
      "diff_removed": "#f27983",
      "diff_removed_background": "#2d1519",
      "permission": "#73d0ff"
    }
  },

  // TUI preview settings: how many lines of each record type to show in the
  // collapsed view. "full" shows the whole record. Disabled by --verbose.
  "tui": {
    "preview_lines_reasoning": 0,
    "preview_lines_context": 2,
    "preview_lines_tool_call": 1,
    "preview_lines_tool_result": 2
  }
}

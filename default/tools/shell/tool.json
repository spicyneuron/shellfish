{
  "description": "Run one Zsh command in the session working directory and return its combined stdout and stderr. Use `$TMPDIR` for temporary files and pass it explicitly to `mktemp`, for example `mktemp \"${TMPDIR%/}/name.XXXXXX\"`. Bare `mktemp` may ignore `$TMPDIR`.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command"],
    "properties": {
      "command": {"type": "string", "minLength": 1},
      "timeout": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 120,
        "description": "Timeout in seconds"
      }
    }
  },
  "display": {
    "summary": [],
    "call": {"content": ["$command"], "format": "sh"},
    "permission_preview": {"content": ["$command"], "format": "sh"},
    "result": {"content": ["$result_preview", "$exit_code"], "format": "plain"}
  },
  "sandbox": true,
  "allow_sandbox_bypass": true
}

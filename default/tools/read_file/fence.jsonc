{
  "network": {
    "allowedDomains": [], "deniedDomains": [],
    "allowLocalBinding": false, "allowLocalOutbound": false
  },
  "filesystem": {
    "defaultDenyRead": true,
    "allowRead": ["."],
    "denyRead": [
      "**/.env", "**/.env.*", "**/.direnv/**", "**/.netrc",
      "**/.git-credentials", "**/.npmrc", "**/.pypirc",
      "**/*.key", "**/*.pem", "**/*.p12", "**/*.pfx"
    ]
  },
  "command": {"useDefaults": true}
}

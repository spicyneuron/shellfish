// Shellfish config
//
// Full reference:
// https://github.com/spicyneuron/shellfish/blob/main/default/shellfish.jsonc
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/shellfish.schema.json",

  "default_profile": "default",

  "profiles": {
    "default": {
      "backend": "openrouter",
      "harness": "default",
      "request": {
        // "model": "MODEL",
        // "reasoning": { "effort": "high" },
        // "temperature": 0.5
      }
    }
  },

  // "default" modifies the built-in default harness. Other harnesses are
  // standalone and do not inherit its system prompts, hooks, or settings.
  "harnesses": {
    "default": {
      "sandbox_read_paths": [
        // Paths outside the project that sandboxed tools may read
      ],
      "sandbox_write_paths": [
        // Paths outside the project that sandboxed tools may read and write
      ]
    },
    "readonly": {
      "system": [],
      "tools": ["read_file", "shell_readonly"],
      "session_start": ["add_project_instructions"],
      "sandbox": true
    }
  }
}

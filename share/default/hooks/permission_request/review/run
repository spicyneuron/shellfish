#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

integer input_tokens=32768
integer output_tokens=4096
integer request_seconds=60
local request header active_header context_window budget system base records transcript
local backend_request response result selected_runtime state_name='' name
local review_content=''
integer review_content_set=0
local -a candidates parent_environment reviewer_environment send_command

permission_deny() {
  local reason=${1//$'\n'/ } control
  reason=${reason//$'\r'/ }
  reason=${reason[1,1000]}
  control=$(jq -cn --arg name "$state_name" --arg reason "$reason" \
      --arg content "$review_content" --argjson content_set "$review_content_set" '
    {action:"deny",reason:$reason} +
    (if $name == "" then {} else
      {state:[{name:$name,value:{
        content:(if $content_set == 1 then $content else null end),reason:$reason}}]}
    end)
  ') || exit 1
  print -rn -u3 -- "$control" || exit 1
  exit 11
}

permission_resolve() {
  local classification=$1 control
  control=$(jq -cn --arg name "$state_name" --argjson classification "$classification" \
      --arg content "$review_content" '
    {low:1,medium:2,high:3} as $rank |
    (if $classification.authorization != null and
        $rank[$classification.authorization] >= $rank[$classification.risk]
     then "allow" else "deny" end) as $decision |
    {state:[{name:$name,value:{content:$content,reason:$classification.reason}}],
      action:$decision} +
    (if $decision == "deny" then {reason:$classification.reason} else {} end)
  ') || exit 1
  print -rn -u3 -- "$control" || exit 1
  exit 11
}

[[ $1 == permission_request && $# == 1 ]] || permission_deny 'Permission review received an invalid invocation.'
[[ -r $SHELLFISH_SESSION && -d $SHELLFISH_TURN_STATE ]] ||
  permission_deny 'Permission review could not read the active turn.'

request=$(cat; printf x)
request=${request%x}
request=$(jq -ce --argjson turn "$SHELLFISH_TURN_ID" '
  select(type == "object" and
    keys == ["tool_input","tool_name","tool_use_id","turn_id"] and
    .turn_id == $turn and
    (.tool_name | type == "string" and test("^[A-Za-z_][A-Za-z0-9_-]*$")) and
    (.tool_use_id | type == "string" and test("^[A-Za-z0-9_-]+$")) and
    (.tool_input | type == "object"))
' <<<"$request" 2>/dev/null) || permission_deny 'Permission review received an invalid tool request.'
state_name=$(jq -r --argjson turn "$SHELLFISH_TURN_ID" '
  "permissions/\($turn)/\(.tool_use_id)"
' <<<"$request") || permission_deny 'Permission review could not prepare state.'
if (( ${#state_name} > 128 )); then
  state_name=''
  permission_deny 'Permission review cannot store this tool request identifier.'
fi

[[ -r ${0:A:h}/review.md ]] && system=$(<"${0:A:h}/review.md") ||
  permission_deny 'Permission review could not load its policy.'

header=$(head -n 1 -- "$SHELLFISH_SESSION") ||
  permission_deny 'Permission review could not inspect the active runtime.'
active_header=$header
parent_environment=( "${(@f)$(jq -r '.backend.environment[]' <<<"$active_header")}" ) ||
  permission_deny 'Permission review could not inspect the active backend environment.'
parent_environment=( "${(@)parent_environment:#}" )
if [[ -n ${SHELLFISH_PERMISSION_PROFILE-} ]]; then
  selected_runtime=$("$SHELLFISH_EXECUTABLE" config --profile \
    "$SHELLFISH_PERMISSION_PROFILE" 2>/dev/null) ||
    permission_deny 'Permission review could not resolve its selected profile.'
  header=$(jq -cn --argjson header "$header" --argjson runtime "$selected_runtime" '
    $header | .profile=$runtime.profile | .backend=$runtime.backend
  ') || permission_deny 'Permission review could not apply its selected profile.'
fi
reviewer_environment=( "${(@f)$(jq -r '.backend.environment[]' <<<"$header")}" ) ||
  permission_deny 'Permission review could not inspect the reviewer backend environment.'
reviewer_environment=( "${(@)reviewer_environment:#}" )
context_window=$(jq -er --argjson output_tokens "$output_tokens" '
  .profile.context_window |
  select(type == "number" and floor == . and . > $output_tokens)
' <<<"$header" 2>/dev/null) ||
  permission_deny 'Permission review has no usable context limit.'
budget=$(( (context_window - output_tokens < input_tokens ?
  context_window - output_tokens : input_tokens) * 4 ))

# The fixed context identifies the session's standing instructions and exact target.
# Timeline records are admitted backward without gaps, then emitted chronologically.
records=$(jq -cse --argjson request "$request" '
  to_entries as $entries |
  ([ $entries[] | select(.value.type == "user") | .key ] | first) as $first_user |
  ([ $entries[] | select(.value.type == "tool_call" and
      .value.id == $request.tool_use_id) | .key ] | last) as $target_index |
  select($first_user != null and $target_index != null and $target_index >= $first_user) |
  $entries[$target_index].value as $target |
  select($target.name == $request.tool_name and $target.input == $request.tool_input) |
  {
    system_message:([
      $entries[] | select(.key < $first_user and .value.type == "system") |
      .value.content
    ] | last),
    startup_context:[
      $entries[] | select(.key < $first_user and .value.type == "hook_result" and
        .value.hook == "session_start" and .value.model_context? != null) | .value |
      {hook,script,content:.model_context}
    ],
    target_tool_call:$target,
    candidates:([
      $entries[] | select(.key < $target_index) | .value as $record |
      if $record.type == "user" then $record
      elif $record.type == "assistant" then
        {type:"assistant",stop:$record.stop,
          content:[$record.content[] | select(.type == "text")]}
      elif $record.type == "tool_call" or $record.type == "tool_result" then $record
      elif $record.type == "hook_result" and $record.hook != "session_start" and
          $record.model_context? != null then
        {type:"hook_context",hook:$record.hook,script:$record.script,
          content:$record.model_context}
      else empty end
    ] | reverse)
  }
' "$SHELLFISH_SESSION" 2>/dev/null) ||
  permission_deny 'Permission review could not project the active context.'

base=$(jq -cn --argjson records "$records" '
  {startup_context:$records.startup_context,recent_timeline:[],
    target_tool_call:$records.target_tool_call} +
  (if $records.system_message == null then {} else
    {system_message:$records.system_message} end)
') || permission_deny 'Permission review could not prepare context.'

integer base_bytes
base_bytes=$(jq -cn --arg system "$system" --argjson context "$base" \
  '($system | utf8bytelength) + ($context | tojson | utf8bytelength)') ||
  permission_deny 'Permission review could not measure required context.'
(( base_bytes <= budget )) ||
  permission_deny 'Required permission review context exceeds the review context limit.'

candidates=( "${(@f)$(jq -c '.candidates[]' <<<"$records")}" ) ||
  permission_deny 'Permission review could not inspect optional context.'
integer candidate_bytes
for candidate in $candidates; do
  context=$(jq -cn --argjson context "$base" --argjson candidate "$candidate" '
    $context | .recent_timeline = ([$candidate] + .recent_timeline)
  ') || permission_deny 'Permission review could not assemble context.'
  candidate_bytes=$(jq -cn --arg system "$system" --argjson context "$context" \
    '($system | utf8bytelength) + ($context | tojson | utf8bytelength)') ||
    permission_deny 'Permission review could not measure optional context.'
  (( candidate_bytes <= budget )) || break
  base=$context
done

transcript="$SHELLFISH_TURN_STATE/permission-review.jsonl"
if ! jq -cn --argjson header "$header" --arg system "$system" --argjson context "$base" \
    --argjson output_tokens "$output_tokens" --argjson request_seconds "$request_seconds" '
  ($header |
    .profile.request |= (
      .max_tokens = ([.max_output_tokens // .max_completion_tokens //
        .max_tokens // $output_tokens,$output_tokens] | min) |
      del(.max_output_tokens,.max_completion_tokens) |
      .response_schema = {
        type:"object",additionalProperties:false,
        required:["risk","authorization","reason"],
        properties:{
          risk:{enum:["low","medium","high"]},
          authorization:{enum:["low","medium","high",null]},
          reason:{type:"string",minLength:1,maxLength:1000}
        }
      }) |
    .profile.system = [] |
    .backend.http_timeout = ([.backend.http_timeout,$request_seconds] | min) |
    .harness |= (.tools=[] | .sandbox=false | .sandbox_read_paths=[] |
      .sandbox_write_paths=[] | .fence="" |
      .session_start=[] | .user_prompt_submit=[] | .permission_request=[] |
      .pre_tool_use=[] | .post_tool_use=[] | .stop=[])),
  {type:"system",content:$system},
  {type:"user",content:[{type:"text",text:($context | tojson)}]}
' >"$transcript"; then
  permission_deny 'Permission review could not construct its temporary runtime.'
fi

backend_request="$SHELLFISH_TURN_STATE/permission-request.json"
if ! "$SHELLFISH_EXECUTABLE" build-request --session "$transcript" --tools '[]' \
    >"$backend_request" 2>/dev/null; then
  permission_deny 'Permission review could not build the provider request.'
fi
send_command=( env )
if [[ -n ${SHELLFISH_PERMISSION_PROFILE-} ]]; then
  for name in $parent_environment; do
    (( ${reviewer_environment[(Ie)$name]} )) || send_command+=( -u "$name" )
  done
fi
send_command+=( "$SHELLFISH_EXECUTABLE" send-request --session "$transcript" )
response=$("${send_command[@]}" <"$backend_request" 2>/dev/null) ||
  permission_deny 'Permission review provider request failed.'

review_content=$(jq -er '
  select(type == "object" and .type == "assistant" and .stop == "end" and
    ([.content[] | select(.type == "text")] | length) == 1) |
  [.content[] | select(.type == "text")][0].text
' <<<"$response" 2>/dev/null) || permission_deny 'Permission review returned an invalid classification.'
review_content_set=1
result=$(jq -ncer --arg content "$review_content" '
  $content | gsub("^\\s+|\\s+$"; "") | fromjson |
  select(type == "object" and keys == ["authorization","reason","risk"] and
    (.risk | IN("low","medium","high")) and
    (.authorization == null or (.authorization | IN("low","medium","high"))) and
    (.reason | type == "string" and length > 0 and length <= 1000 and
      (test("[[:cntrl:]]") | not)))
' 2>/dev/null) || permission_deny 'Permission review returned an invalid classification.'

permission_resolve "$result"

{
  "match": {
    "pattern": "^/copy( [^\\n]*)?\\z"
  },
  "render": {
    "user_before": "",
    "user_after": "${script}\n${output.stdout}${output.stderr}",
    "model_after": "${output.stdout}"
  },
  "help": {
    "usage": "/copy [N]",
    "description": "Copy the latest or selected user/agent section"
  }
}

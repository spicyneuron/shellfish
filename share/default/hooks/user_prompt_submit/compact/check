#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_multios pipe_fail

typeset submitted
submitted=$(cat; printf x)
submitted=${submitted%x}

[[ $submitted != /compact ]] || exit 0

# Automatic compaction measures the most recent response against the frozen
# window. Eligibility is the run script's; this is only the threshold.
jq -es '
  .[0].runtime.profile.context_window as $window |
  ([.[] | select(.type == "assistant" and .usage != null)] | last) as $measured |
  $window != null and $measured != null and
  (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
' "$SHELLFISH_SESSION" >/dev/null 2>&1 || exit 1
exit 0

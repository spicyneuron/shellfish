#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset submitted draft='' instruction budget request summary created base candidate
typeset transcript installed
typeset -a argv
integer explicit=0 suffix=1 install_status=0

fail_compaction() {
  print -u2 -r -- "$1"
  (( explicit )) && return 10
  return 0
}

submitted=$(cat; printf x)
submitted=${submitted%x}

case $submitted in
  /help|/h)
    print -r -- $'113\t/compact\tSummarize this session into a new one' \
      >>"$SHELLFISH_TURN_STATE/help.tsv"
    exit 0
    ;;
  /compact)
    explicit=1
    jq -es 'any(.[]; .type == "message")' "$SHELLFISH_SESSION" >/dev/null 2>&1 || {
      print -u2 -r -- 'nothing to compact yet'
      exit 10
    }
    ;;
  *)
    # Automatic compaction uses the most recent measured response only after a
    # complete assistant turn.
    jq -es '
      .[0].profile.context_window as $window |
      [.[] | select(.type == "message" and .role == "assistant")] as $assistants |
      ($assistants | map(select(.usage != null)) | last) as $measured |
      $window != null and $measured != null and
      $assistants[-1].stop != "tool_calls" and
      (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
    ' "$SHELLFISH_SESSION" >/dev/null 2>&1 || exit 0
    draft=$submitted
    ;;
esac

[[ -r ${0:A:h}/compact.md ]] && instruction=$(<"${0:A:h}/compact.md") || {
  fail_compaction 'cannot read compaction prompt; keeping the original'
  exit $?
}
budget=$(jq -er '
  .profile.context_window | select(. != null) |
  [(. / 10 | floor), 1] | max
' <"$SHELLFISH_SESSION" 2>/dev/null) || budget=''
if [[ -n $budget ]]; then
  instruction+=$'\n\n## Summary budget\n\nAim to keep the summary within '"$budget"$' tokens (10% of the session context window). Do not add low-value detail merely to fill the budget.'
else
  instruction+=$'\n\n## Summary budget\n\nNo context-window size is available. Be aggressively concise while preserving all required continuation state.'
fi
instruction=$'<compaction_request>\n\n'"$instruction"$'\n\n</compaction_request>'
request=$(jq -cn --arg text "$instruction" \
  '{type:"message",role:"user",content:[{type:"text",text:$text}]}') || {
  fail_compaction 'cannot prepare summary request; keeping the original'
  exit $?
}
print -u2 -r -- 'Compacting conversation…'
summary=$(print -r -- "$request" |
  "$SHELLFISH_EXECUTABLE" build-request --session "$SHELLFISH_SESSION" --tools '[]' |
  "$SHELLFISH_EXECUTABLE" send-request --session "$SHELLFISH_SESSION" |
  jq -er '[.content[] | select(.type == "text") | .text] | join("") |
    select(test("[^[:space:]]"))') || {
  fail_compaction 'cannot summarize session; keeping the original'
  exit $?
}

created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || {
  fail_compaction 'cannot create compacted session; keeping the original'
  exit $?
}
transcript="$SHELLFISH_TURN_STATE/compact.jsonl"
# Startup records without state, then every state record in source order, so the
# child reconstructs the same effective state without interpreting names.
if ! jq -ce -s --rawfile summary <(print -rn -- "$summary") --arg created "$created" '
    . as $records |
    ([$records | to_entries[] | select(.value.type == "message") | .key] | first) as $start |
    select($start != null) |
    ($records[0:$start] | .[0].created = $created) as $startup |
    ($startup[] | select(.type != "state")),
    ($records[] | select(.type == "state")),
    {type:"context",hook:"compact",script:"compact",content:$summary}
  ' "$SHELLFISH_SESSION" >"$transcript"; then
  fail_compaction 'cannot create compacted session; keeping the original'
  exit $?
fi

base=${SHELLFISH_SESSION%.jsonl}
base=${base%_compact(|_<->)}
candidate="${base}_compact.jsonl"
while true; do
  install_status=0
  installed=$("$SHELLFISH_EXECUTABLE" install-session --session-out "$candidate" \
    <"$transcript" 2>/dev/null) || install_status=$?
  (( install_status )) || break
  # Status 3 means the name is taken; anything else is a real failure.
  if (( install_status != 3 )); then
    fail_compaction 'cannot create compacted session; keeping the original'
    exit $?
  fi
  candidate="${base}_compact_${suffix}.jsonl"
  (( suffix++ ))
done

argv=( "$SHELLFISH_EXECUTABLE" --session "$installed" )
[[ -z $draft ]] || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
exit 11

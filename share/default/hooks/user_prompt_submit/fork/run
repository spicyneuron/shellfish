#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset submitted='' target=0 base candidate created draft='' resolved
typeset transcript installed
typeset -a argv fields
integer read_status suffix=1 cutoff=0 explicit=0 has_draft=0
IFS= read -r submitted
read_status=$?

case "$read_status:$submitted" in
  1:/help|1:/h)
    print -r -- $'112\t/fork [N]\tFork at the following user section (default: current end)' >>"$SHELLFISH_TURN_STATE/help.tsv"
    exit 0
    ;;
  1:/fork) ;;
  1:'/fork '*)
    explicit=1
    target=${submitted#* }
    target=${target##[[:space:]]#}
    ;;
  *) exit 0 ;;
esac

if [[ $target != <-> || ${#target} -gt 9 ]] || (( explicit && target == 0 )); then
  print -u2 -r -- 'usage: /fork [N]'
  exit 10
fi

resolved=$(jq -j -s --argjson target "$target" '
  . as $records |
  (reduce ($records | to_entries[] | select(.value.type == "message" and
      (.value.role == "user" or .value.role == "assistant"))) as $entry
    ([];
      if $entry.value.role == "user" then
        . + [{role:"user",index:$entry.key,draft:$entry.value.content[0].text}]
      elif length == 0 or .[-1].role != "assistant" then
        . + [{role:"assistant"}]
      else . end)) as $sections |
  if ($sections | any(.role == "user") | not) then error("empty")
  elif $target == 0 then [($records | length), "", 0]
  elif $target > ($sections | length) then error("missing")
  elif $sections[$target - 1].role == "user" then
    ($sections[$target - 1] | [.index, .draft, 1])
  else ([$sections[$target:][] | select(.role == "user")] | first) as $next |
    if $next == null then [($records | length), "", 0]
    else [$next.index, $next.draft, 1] end
  end | "\(.[0])\u0000\(.[1])\u0000\(.[2])\u0000"
' "$SHELLFISH_SESSION" 2>/dev/null) || {
  print -u2 -r -- 'fork target does not exist'
  exit 10
}
fields=( "${(@0)${resolved%$'\0'}}" )
(( ${#fields} == 3 )) || exit 1
cutoff=$fields[1]
draft=$fields[2]
has_draft=$fields[3]

created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || exit 1
transcript="$SHELLFISH_TURN_STATE/fork.jsonl"
if ! jq -ce -s --argjson cutoff "$cutoff" --arg created "$created" '
  .[0:$cutoff] | .[0].created = $created | .[]
' "$SHELLFISH_SESSION" >"$transcript"; then
  print -u2 -r -- 'cannot fork session'
  exit 10
fi

base=${SHELLFISH_SESSION%.jsonl}
base=${base%_fork(|_<->)}
base="${base}_fork"
while true; do
  candidate="${base}_${suffix}.jsonl"
  installed=$("$SHELLFISH_EXECUTABLE" install-session --session-out "$candidate" \
    <"$transcript" 2>/dev/null) && break
  if [[ ! -e $candidate && ! -L $candidate ]]; then
    print -u2 -r -- "cannot create fork: $candidate"
    exit 10
  fi
  (( suffix++ ))
done

argv=( "$SHELLFISH_EXECUTABLE" --session "$installed" )
(( ! has_draft )) || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
exit 11

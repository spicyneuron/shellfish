{
  "match": {
    "pattern": "^/fork( [^\\n]*)?\\z"
  },
  "render": {
    "user_before": "${script} · Forking session…",
    "user_after": "${script}\n${output.stdout}${output.stderr}",
    "model_after": "${output.stdout}"
  },
  "help": {
    "usage": "/fork [N]",
    "description": "Fork at the following user section (default: current end)"
  }
}

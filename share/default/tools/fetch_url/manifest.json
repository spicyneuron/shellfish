{
  "description": "Fetch an HTTP(S) website through Jina Reader and return its content as Markdown. The requested URL is sent to Jina AI. Use this for website content that is not already available in the project.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["url"],
    "properties": {
      "url": {"type": "string", "minLength": 1, "description": "HTTP(S) URL to fetch"}
    }
  },
  "render": {
    "user_before": "${tool} · ${input.url}",
    "user_after": "${tool} · ${input.url}\n${output.stdout}${output.stderr}",
    "model_after": "${output.stdout}${output.stderr}"
  },
  "permission_preview": "${input.url}",
  "sandbox": true
}

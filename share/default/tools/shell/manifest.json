{
  "description": "Run one zsh command in the session working directory and return its combined stdout and stderr.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command"],
    "properties": {
      "command": {"type": "string", "minLength": 1},
      "timeout": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 120,
        "description": "Timeout in seconds"
      }
    }
  },
  "render": {
    "running": "${name}\n${input.command}",
    "user": "${name}\n${input.command}\n${output.stdout}${output.stderr}\nexit ${output.exit_code}",
    "model": "${output.stdout}${output.stderr}\nexit ${output.exit_code}",
    "permission": "${input.command}"
  },
  "sandbox": true,
  "allow_sandbox_bypass": true
}

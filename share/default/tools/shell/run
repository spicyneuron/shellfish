#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_bg_nice no_multios pipe_fail
zmodload zsh/system
zmodload zsh/zselect

typeset projection command parent=$sysparams[pid]
typeset -a fields
integer timeout command_pid=0 watchdog_pid=0 timed_out=0 result=0

projection=$(jq -jre '
  select(type == "object" and
    (.command | type == "string" and length > 0 and index("\u0000") == null) and
    ((.timeout // 120) | type == "number" and floor == . and . >= 1 and . <= 3600) and
    (keys - ["command", "timeout"] | length == 0)) |
  .command, "\u0000", (.timeout // 120 | tostring), "\u0000", "ok", "\u0000"
') || {
  print -u2 -r -- 'shell: invalid input'
  exit 2
}
fields=( "${(@0)${projection%$'\0'}}" )
(( ${#fields} == 3 )) && [[ $fields[3] == ok ]] || {
  print -u2 -r -- 'shell: invalid input'
  exit 2
}
command=$fields[1]
timeout=$fields[2]

stop_process() {
  local pid=$1
  (( pid > 0 )) || return 0
  kill -TERM "$pid" 2>/dev/null || true
  zselect -t 10 2>/dev/null || true
  kill -KILL "$pid" 2>/dev/null || true
}

cleanup() {
  local pid=$watchdog_pid
  watchdog_pid=0
  if (( pid > 0 )); then
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  stop_process "$command_pid"
  command_pid=0
}

trap cleanup EXIT
trap 'cleanup; exit 143' TERM
trap 'timed_out=1; stop_process "$command_pid"' ALRM
# fd 3 closes before the model-authored command runs so it cannot forge state.
zsh -f -c "$command" 3>&- 2>&1 &
command_pid=$!
{
  zselect -t $(( timeout * 100 )) 2>/dev/null || true
  kill -ALRM "$parent" 2>/dev/null
} &
watchdog_pid=$!

set +e
wait "$command_pid"
result=$?
(( ! timed_out )) || wait "$command_pid" 2>/dev/null
set -e
command_pid=0
kill -TERM "$watchdog_pid" 2>/dev/null || true
wait "$watchdog_pid" 2>/dev/null || true
watchdog_pid=0
trap - ALRM
if (( timed_out )); then
  print -u2 -r -- "shell: timed out after $timeout seconds"
  exit 124
fi
exit "$result"

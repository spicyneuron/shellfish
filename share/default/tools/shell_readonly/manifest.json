{
  "description": "Run one zsh command in the session working directory and return its combined output. Read only.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command"],
    "properties": {
      "command": {"type": "string", "minLength": 1},
      "timeout": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 30,
        "description": "Timeout in seconds"
      }
    }
  },
  "render": {
    "user_before": "${script}\n${input.command}",
    "user_after": "${script}\n${input.command}\n${output.stdout}${output.stderr}\nexit ${output.exit_code}",
    "model_after": "${output.stdout}${output.stderr}\nexit ${output.exit_code}"
  },
  "permission_preview": "${input.command}",
  "sandbox": true
}

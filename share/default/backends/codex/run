#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail
umask 077

source "${0:A:h:h}/_backend.zsh"
typeset -gr ENDPOINT=https://chatgpt.com/backend-api/codex/responses
unset SHELLFISH_API_KEY SHELLFISH_RESPONSES_ACCOUNT_ID

sf_backend_setup codex
trap 'rm -rf -- "$SF_BACKEND_TEMP_DIR"' EXIT
typeset prepared_file=$SF_BACKEND_TEMP_DIR/prepared.json
typeset codex_home auth_file credentials
typeset access_token='' account_id=''
cat >"$SF_BACKEND_REQUEST_FILE"

# The request body carries backend-neutral fields as well as Codex options.
# Codex accepts only reasoning; the Responses adapter owns the generated body.
sf_backend_request '(.options.request | has("reasoning") | not) or
  (.options.request.reasoning | type == "object")' ||
  sf_backend_die 'invalid request'
[[ $SF_BACKEND_ENDPOINT == $ENDPOINT && $SF_BACKEND_INSECURE_TLS == false ]] ||
  sf_backend_die 'Codex transport must use the built-in secure endpoint'

# Reasoning comes back encrypted, so a summary is its only readable trace. Asked
# for here rather than in the shared Responses backend, which points at whatever
# model a provider configures; this transport is pinned to one Codex endpoint.
# The summary is forced after raw options are applied; effort stays the caller's.
jq -c '.options.request |=
  (. + {reasoning:((.reasoning // {} | if . == {effort:""} then {} else . end) * {summary:"auto"})})' \
  "$SF_BACKEND_REQUEST_FILE" >"$prepared_file" || sf_backend_die "cannot prepare canonical request"

command -v codex >/dev/null 2>&1 || sf_backend_die "Codex CLI is not installed"

if [[ -n ${CODEX_HOME-} ]]; then
  codex_home=$CODEX_HOME
elif [[ -n ${HOME-} ]]; then
  codex_home=$HOME/.codex
else
  sf_backend_die "cannot locate Codex credentials without CODEX_HOME or HOME"
fi
auth_file=$codex_home/auth.json
[[ -f $auth_file && -r $auth_file ]] || \
  sf_backend_die "Codex credentials are unavailable; authenticate using Codex and retry"
credentials=$(jq -er '
  select(
    .auth_mode == "chatgpt" and
    (.tokens.access_token | type == "string" and length > 0 and
      (test("[[:cntrl:]]") | not)) and
    (.tokens.account_id | type == "string" and length > 0 and
      (test("[[:cntrl:]]") | not))
  ) |
  [["access_token",.tokens.access_token],
   ["account_id",.tokens.account_id]][] |
  join("\u001c")
' "$auth_file" 2>/dev/null) || \
  sf_backend_die "Codex ChatGPT credentials are unavailable; authenticate using Codex and retry"
while IFS=$'\034' read -r name value; do
  case $name in
    access_token) access_token=$value ;;
    account_id) account_id=$value ;;
    *) sf_backend_die "Codex ChatGPT credentials are unavailable; authenticate using Codex and retry" ;;
  esac
done <<<"$credentials"
[[ -n $access_token && -n $account_id ]] || \
  sf_backend_die "Codex ChatGPT credentials are unavailable; authenticate using Codex and retry"

SHELLFISH_API_KEY=$access_token SHELLFISH_RESPONSES_ACCOUNT_ID=$account_id \
  SHELLFISH_API_KEY_SOURCE='Codex CLI login' \
  "${0:A:h:h}/openai-responses/run" <"$prepared_file"
unset access_token account_id credentials

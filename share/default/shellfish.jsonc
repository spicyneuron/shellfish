// Shellfish: https://github.com/spicyneuron/shellfish
//
// Default configuration. $XDG_CONFIG_HOME/shellfish/shellfish.jsonc is merged over
// this file.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/shellfish.schema.json",

  // Profile selected when --profile is not given on the command line.
  "default_profile": "default",

  // Profiles compose a backend, a harness, and request overrides. "extend"
  // inherits from another profile and later keys override. "request" holds
  // model and other parameters passed through to backend adapters. "max_tokens"
  // and "reasoning.effort" are normalized in default backends. An optional
  // "context_window" overrides best-effort model metadata discovery. "system"
  // lists files under system/ concatenated into the system prompt.
  "profiles": {
    "default": {
      "harness": "default",
      "system": ["general.md", "tools.md"],
      "request": {"max_tokens": 16384, "reasoning": {"effort": "medium"}}
    }
  },

  // Backends are API adapters. "adapter" names the run script under
  // backends/<adapter>/; "endpoint" and "environment" override the adapter's
  // built-in manifest. Environment names are passed without translation.
  // Codex relies on an existing CLI login. The "openai" adapter works with any
  // OpenAI-compatible endpoint. Optional transport knobs not shown here:
  // insecure_tls, http_timeout, http_stall.
  "backends": {
    "anthropic": {"adapter": "anthropic"},
    "codex": {"adapter": "codex"},
    "openai": {"adapter": "openai"},
    "openai-responses": {"adapter": "openai-responses"},
    "openrouter": {"adapter": "openrouter"}
  },

  // Harnesses wrap the shared turn loop with context, capabilities, sandboxing,
  // and limits.
  "harnesses": {
    "default": {
      // Tools available to the model.
      "tools": ["read_file", "edit_file", "write_file", "skill", "search_web", "fetch_url", "shell"],

      // Each hook runs an ordered list of components. See docs/HARNESS.md for
      // payloads, exit statuses, and environment guarantees.
      "session_start": ["project_environment", "git_environment", "project_instructions"],
      "user_prompt_submit": ["help", "verbose", "new", "copy", "fork", "sandbox", "user_shell", "server", "resume", "compact", "git_environment"],
      // Opt in to agentic permission review with ["review"].
      "permission_request": [],
      "pre_tool_use": [],
      "post_tool_use": [],
      "stop": [],

      // "sandbox" enables fence for tools that opt in via their manifest.
      // sandbox_read_paths/sandbox_write_paths grant extra paths beyond the
      // project directory while keeping the tool's other restrictions.
      "sandbox": true,
      "sandbox_read_paths": [],
      "sandbox_write_paths": [],

      // Caps for requests, tool calls, and bytes from a single tool result.
      "max_requests_per_turn": 100,
      "max_tool_calls_per_request": 25,
      "max_capture_bytes": 32768
    }
  }
}

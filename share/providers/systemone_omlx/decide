#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail
umask 077

source "${0:A:h:h}/_provider.zsh"
SF_PROVIDER_NAME=systemone_omlx

# oMLX takes media as unplaced top-level lists, which the System One provider
# passes through from the request.
request=$(jq -ce '
  def urls($type): [.input[] | select(.type == $type) | .url];
  urls("image") as $images | urls("video") as $videos |
  .request += (if $images == [] then {} else {images:$images} end) +
    (if $videos == [] then {} else {videos:$videos} end) |
  .input |= map(select(.type != "image" and .type != "video"))
') || sf_provider_die 'cannot translate request'

TYPESAFE_API_KEY=${OMLX_API_KEY-} "${0:A:h:h}/systemone/decide" <<<"$request"

// Shellfish: https://github.com/spicyneuron/shellfish
//
// The bundled agent, selected when --profile is absent. A profile file in
// $XDG_CONFIG_HOME/shellfish/profiles/ shadows a bundled one of the same name.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/shellfish.schema.json",

  // "adapter" names a directory under backends/; "endpoint" overrides the
  // adapter's manifest. Credentials come from the environment or .env in the
  // config directory. Codex relies on an existing CLI login. The "openai" adapter
  // works with any OpenAI-compatible endpoint. Optional transport knobs not
  // shown here: insecure_tls, http_timeout, http_stall.
  "backend": {"adapter": "openrouter"},

  // Parameters passed through to the backend adapter. "max_tokens" and
  // "reasoning.effort" are normalized in the bundled adapters.
  "request": {"max_tokens": 16384, "reasoning": {"effort": "medium"}},

  // Files under system/ concatenated into the system prompt.
  "system": ["general.md", "tools.md"],

  // Uncomment to override best-effort model metadata discovery, or set null to
  // disable it.
  // "context_window": 200000,

  // Tools available to the model.
  "tools": ["read_file", "edit_file", "write_file", "skill", "search_web", "fetch_url", "shell"],

  // Ordered hooks run only when listed here. See docs/HARNESS.md.
  "hooks": {
    "session_start": ["project_environment", "git_environment", "project_instructions"],
    "user_prompt_submit": ["user_prompt_submit"]
  },

  // "sandbox" enables fence for tools that opt in via their manifest.
  // sandbox_read_paths/sandbox_write_paths grant extra paths beyond the
  // project directory while keeping the tool's other restrictions.
  "sandbox": true,
  "sandbox_read_paths": [],
  "sandbox_write_paths": [],

  // Caps for requests, tool calls, and bytes from a single tool result.
  "max_requests_per_turn": 100,
  "max_tool_calls_per_request": 25,
  "max_capture_bytes": 32768
}

// Shellfish: https://github.com/spicyneuron/shellfish
//
// The bundled agent, selected when --profile is absent. A profile only selects:
// model files, system prompt files, tools, and hooks. A file in the Shellfish
// directory's profiles/ shadows a bundled one of the same name.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/profile.schema.json",

  // Files under models/, merged left to right: the bundled defaults, then your
  // models/default.jsonc, which must name a model.
  "model": ["@default", "default"],

  // Files under system/ concatenated into the system prompt.
  "system": ["general.md", "tools.md"],

  // Tools available to the model.
  "tools": ["read_file", "edit_file", "write_file", "skill", "search_web", "fetch_url", "shell"],

  // Hooks run in this order within the lifecycle their manifest names.
  "hooks": [
    "project/environment", "git/environment", "project/instructions",
    "help", "verbose", "new", "resume", "server", "copy", "sandbox", "user_shell",
    "fork", "compact", "git/change", "skills"
  ]
}

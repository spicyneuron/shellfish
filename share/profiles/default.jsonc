// Shellfish profile: https://github.com/spicyneuron/shellfish
//
// Selected when --profile is absent. init copies this profile for customization.
// A profile selects sandbox settings, system prompts, tools, commands, and hooks,
// with optional config. The model is chosen separately.
// A name resolves in this Shellfish directory first, then the bundled one.
// A path starts with "/", "~/", "./", "../", or "@" for the bundled root.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/profile.schema.json",

  "sandbox": {
    // Setting false runs every tool with user permissions.
    "enabled": true,
    // Seconds to wait for user approval of a sandbox bypass.
    "user_approval_timeout": 120,
    // Extra grants keyed by selected tool name.
    "tools": {
      // "shell": {"read": ["~/.cargo"], "write": ["~/.cache/uv"], "domains": ["github.com"]}
    }
  },

  // Files under system/ concatenated into the system prompt.
  "system": ["general.md", "tools.md", "sandbox.md"],

  // Tools available to the model.
  "tools": [
    "read_file", "edit_file", "write_file", "shell", "search_web", "fetch_url", "skill",
    // Delegate tasks to subagents.
    // "subagent",
  ],

  // Commands typed as /NAME, which run instead of submitting the prompt.
  "commands": ["help", "verbose", "new", "resume", "fork", "rewind", "compact", "copy", "user_shell", "sandbox"],

  // Hooks run in this order within the lifecycle their manifest names.
  "hooks": [
    "project/environment", "git/environment", "project/instructions", "skills/list",
    "autocompact", "git/identity", "skills/mention",
    // Have a model review sandbox bypass requests.
    // "sandbox/approver",
  ],

  // Optional settings for the components above.
  // "config": {
  //   "subagent": {
  //     "profiles": {"readonly": "Investigate and answer questions without changing files"},
  //     "max_active": 4
  //   },
  //   "sandbox": {
  //     "approver": {"model": "default"}
  //   }
  // }
}

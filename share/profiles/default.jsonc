// Shellfish profile: https://github.com/spicyneuron/shellfish
//
// Selected when --profile is absent. init copies this profile for customization.
// A profile selects sandbox settings, system prompts, tools, commands, and hooks,
// with optional config. The model is chosen separately.
// A name resolves in this Shellfish directory first, then the bundled one.
// A path starts with "/", "~/", "./", "../", or "@" for the bundled root.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/profile.schema.json",

  // Files under system/ concatenated into the system prompt.
  "system": ["general.md", "tools.md", "sandbox.md"],

  // Tools available to the model.
  "tools": [
    "read_file", "edit_file", "write_file", "shell", "search_web", "fetch_url", "skill",
    // Delegate tasks to subagents.
    // "subagent",
  ],

  // Commands typed as /NAME, which run instead of submitting the prompt.
  "commands": ["help", "verbose", "new", "resume", "fork", "rewind", "compact", "compact_tools", "copy", "user_shell", "sandbox"],

  // Hooks run in this order within the lifecycle their manifest names.
  "hooks": [
    "project/environment", "git/environment", "project/instructions", "skills/list", "sandbox/grants",
    "autocompact", "git/identity", "skills/mention",
    // Have a model review sandbox access requests.
    // "sandbox/approver",
  ],

  // Optional settings for the components above.
  // "config": {
  //   "subagent": {
  //     "profiles": {"readonly": "Investigate and answer questions without changing files"},
  //     "max_active": 4
  //   },
  //   "sandbox": {
  //     "approver": {"model": "default"}
  //   }
  // },

  "sandbox": {
    // Setting false runs every tool with user permissions.
    "enabled": true,
    // Seconds to wait for user approval of a sandbox access request.
    "user_approval_timeout": 120,
    // Fence policies keyed by selected tool name. Lists extend the tool policy.
    // Grants apply only to the named tool. Existing deny rules still win.
    // Paths starting with ./ or ../ are relative to this profile's directory.
    // Use ~ for home paths, or . for the session directory.
    // Set "replace": true inside a tool entry to discard its bundled policy,
    // including its protections for secrets and .shellfish directories.
    "tools": {
      // Let uv install packages using its cache and PyPI.
      // "shell": {
      //   "filesystem": {"allowRead": ["~/.cache/uv"], "allowWrite": ["~/.cache/uv"]},
      //   "network": {"allowedDomains": ["pypi.org", "files.pythonhosted.org"]}
      // },
      // Edit a shared library outside the session directory.
      // "edit_file": {
      //   "filesystem": {"allowRead": ["~/projects/shared"], "allowWrite": ["~/projects/shared"]}
      // },
      // Use your own Fence policy file instead of read_file's bundled policy.
      // This file must exist, relative to this profile's directory.
      // "read_file": {
      //   "replace": true,
      //   "extends": "../sandboxes/read-only.jsonc"
      // },
    }
  }
}

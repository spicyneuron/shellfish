#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_bg_nice no_multios pipe_fail

typeset input operation profile task agent_id child parent_dir association value output fork transcript background launch_error
typeset limit=${SHELLFISH_MAX_ACTIVE_AGENTS-4}
integer count=0 result=0

fail() { print -u2 -r -- "agent: $1"; exit ${2:-1}; }

input=$(cat) || fail 'cannot read input'
operation=$(jq -er '
  select(type == "object" and
    ((keys - ["operation", "profile", "fork", "task", "agent_id", "background"]) | length == 0)) |
  if .operation == "start" and
     ((has("profile") and (has("fork") | not) and
       (.profile | type == "string" and length > 0)) or
      (has("fork") and (has("profile") | not) and .fork == true)) and
     (.task | type == "string" and length > 0) and
     (if has("background") then .background | type == "boolean" else true end) and
     (has("agent_id") | not) then "start"
  elif (.operation == "inspect" or .operation == "continue") and
       (.agent_id | type == "string" and test("^[a-f0-9]{32}$")) and
       (has("profile") | not) and (has("fork") | not) and
       (if .operation == "continue" then
         (.task | type == "string" and length > 0) and
         (if has("background") then .background | type == "boolean" else true end)
       else (has("task") | not) and (has("background") | not) end) then .operation
  else empty end
' <<<"$input" 2>/dev/null) || fail 'invalid input' 2

[[ -n ${SHELLFISH_SESSION-} && -n ${SHELLFISH_EXECUTABLE-} ]] ||
  fail 'session environment is unavailable'
[[ $limit == <1-> ]] || fail 'SHELLFISH_MAX_ACTIVE_AGENTS must be a positive integer' 2
parent_dir=${SHELLFISH_SESSION:A:h}

# The marker is feature-owned state, appended only after session_start settles.
if jq -e 'select(.type == "state" and .name == "agents/child")' \
    "$SHELLFISH_SESSION" >/dev/null 2>&1; then
  fail 'a child agent cannot delegate'
fi

if [[ $operation == inspect || $operation == continue ]]; then
  agent_id=$(jq -r '.agent_id' <<<"$input")
else
  fork=$(jq -r '.fork // false' <<<"$input")
  background=$(jq -r '.background // false' <<<"$input")
  [[ $fork == true ]] || profile=$(jq -r '.profile' <<<"$input")
  task=$(jq -r '.task' <<<"$input")
  agent_id=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]') || fail 'cannot create agent ID'
  [[ $agent_id == [a-f0-9]## ]] || fail 'cannot create agent ID'
fi

child="$parent_dir/.agent-$agent_id.jsonl"
if [[ $operation == inspect || $operation == continue ]]; then
  association=$(jq -c -s --arg name "agents/$agent_id" \
    '[.[] | select(.type == "state" and .name == $name) | .value] | last // empty' \
    "$SHELLFISH_SESSION") || fail 'cannot read agent association'
  [[ -n $association ]] || fail 'unknown agent_id' 2
  jq -e --arg session ".agent-$agent_id.jsonl" \
    '.session == $session and (.active | type == "boolean")' \
    <<<"$association" >/dev/null || fail 'invalid agent association'
  [[ -f $child && ! -L $child ]] || fail 'agent session is unavailable'
  output=$(jq -c -s --arg id "$agent_id" --argjson association "$association" '
    if length < 2 or .[0].type != "session" or
       (any(.[1:][]; . == {type:"state",name:"agents/child",value:true}) | not) or
       (all(.[]; .type | IN("session","system","state","hook_result","user",
         "assistant","tool_result","error")) | not) then
      error("invalid agent session")
    else
      ([to_entries[] | select(.value.type == "user") | .key] | last) as $turn |
      (if $turn == null then [] else .[$turn:] end) as $records |
      ($records[-1].type // null) as $last |
      {agent_id:$id, active:$association.active,
       settled:($last == "error" or
         ($last == "assistant" and $records[-1].stop == "end" and
          ((.[0].profile.hooks.stop // []) | length == 0))),
       answer:([$records[] | select(.type == "assistant" and .stop == "end") |
         [.content[] | select(.type == "text") | .text] | join("\n")] | last // null),
       last_record:$last}
    end
  ' "$child") || fail 'cannot inspect agent session'
  if [[ $operation == inspect ]]; then
    if jq -e '.active == true and .settled == true' <<<"$output" >/dev/null; then
      print -r -u3 -- "$(jq -cn --arg name "agents/$agent_id" \
        --arg session ".agent-$agent_id.jsonl" \
        '{state:[{name:$name,value:{session:$session,active:false}}]}')" ||
        fail 'cannot release agent slot'
      output=$(jq -c '.active=false' <<<"$output") || fail 'cannot format inspection'
    fi
    print -r -- "$output"
    exit 0
  fi
  # A synchronous run releases its slot only after exit, even with stop hooks.
  jq -e '.active == false' <<<"$output" >/dev/null &&
    jq -e -s '.[-1].type == "error" or
      (.[-1].type == "assistant" and .[-1].stop == "end")' "$child" >/dev/null ||
    fail 'agent prior turn is active or uncertain' 2
  background=$(jq -r '.background // false' <<<"$input")
  task=$(jq -r '.task' <<<"$input")
fi

# A later state record supersedes an earlier reservation.
count=$(jq -s '[.[] | select(.type == "state" and (.name | startswith("agents/"))) |
  {key:.name,value:.value}] | from_entries | [.[] | select(.active? == true)] | length' \
  "$SHELLFISH_SESSION") || fail 'cannot read parent state'
(( count < limit )) || fail "active agent limit reached ($limit)"

if [[ $operation == start ]]; then
  # Reserve a unique hidden path before creating it through the public interface.
  [[ ! -e $child && ! -L $child ]] || fail 'agent ID collision'
  if [[ $fork == true ]]; then
    # The last user starts the invoking turn. Nothing from that turn is inherited.
    transcript=$(mktemp "$parent_dir/.agent-fork.XXXXXX") || fail 'cannot prepare fork'
    if ! jq -ce -s '
          if length == 0 or .[0].type != "session" then
            error("invalid parent session")
          else
            . as $records |
            ([$records | to_entries[] | select(.value.type == "user") | .key] | last) as $turn |
            $records[0:($turn // length)][]
          end
        ' "$SHELLFISH_SESSION" >"$transcript" 2>/dev/null; then
      rm -f -- "$transcript"
      fail 'cannot fork parent session'
    fi
    if ! ln "$transcript" "$child" 2>/dev/null; then
      rm -f -- "$transcript"
      fail 'cannot create agent session'
    fi
    rm -f -- "$transcript"
  else
    "$SHELLFISH_EXECUTABLE" run --session-create --session-out "$child" \
      --profile "$profile" >/dev/null || fail 'cannot create agent session'
  fi
  print -r -- '{"type":"state","name":"agents/child","value":true}' >>"$child" ||
    fail 'cannot mark child session'
fi
if [[ $background == true ]]; then
  launch_error=$(mktemp "${TMPDIR:-/tmp}/shellfish-agent-launch.XXXXXX") ||
    fail 'cannot prepare background launch'
fi
value=$(jq -cn --arg session ".agent-$agent_id.jsonl" \
  '{session:$session,active:true}') || fail 'cannot reserve agent'
print -r -u3 -- "$(jq -cn --arg name "agents/$agent_id" --argjson value "$value" \
  '{state:[{name:$name,value:$value}]}')" || fail 'cannot reserve agent'

if [[ $background == true ]]; then
  output=$("$SHELLFISH_EXECUTABLE" run --background --session "$child" -- "$task" \
    2>"$launch_error")
  result=$?
  if (( result )); then
    # Only diagnostics emitted before worker launch prove the slot is unused.
    if grep -Eq '^shellfish: (--background requires macOS /usr/bin/script or Linux setsid|cannot prepare background turn|cannot prepare background acknowledgement)$' "$launch_error"; then
      print -r -u3 -- "$(jq -cn --arg name "agents/$agent_id" \
        --arg session ".agent-$agent_id.jsonl" \
        '{state:[{name:$name,value:{session:$session,active:false}}]}')" ||
        fail 'cannot release agent slot'
    fi
    cat "$launch_error" >&2
    rm -f -- "$launch_error"
    fail 'cannot launch background agent'
  fi
  rm -f -- "$launch_error"
  [[ $output == "$child" ]] || fail 'background launch acknowledgement is invalid'
  print -r -- "$(jq -cn --arg id "$agent_id" '{agent_id:$id,active:true,settled:false}')"
  exit 0
fi

"$SHELLFISH_EXECUTABLE" run --session "$child" -- "$task" >/dev/null 2>&1
result=$?
print -r -u3 -- "$(jq -cn --arg name "agents/$agent_id" --arg session ".agent-$agent_id.jsonl" \
  '{state:[{name:$name,value:{session:$session,active:false}}]}')" ||
  fail 'cannot release agent slot'
output=$(jq -c -s --arg id "$agent_id" --argjson exit_code "$result" '
  {agent_id:$id,exit_code:$exit_code,
   answer:([.[] | select(.type == "assistant" and .stop == "end") |
     [.content[] | select(.type == "text") | .text] | join("\n")] | last // null)}
' "$child") || fail 'cannot read agent result'
print -r -- "$output"
exit "$result"

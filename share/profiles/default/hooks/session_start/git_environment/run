#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_bg_nice no_multios pipe_fail
zmodload zsh/datetime
source "${0:A:h:h:h:h}/lib/capped.zsh" || exit 1

typeset -F deadline=$(( EPOCHREALTIME + SF_PROBE_BUDGET ))

typeset branch hash identity commits git_status
integer probe_status
branch=$(sf_capped "$deadline" git symbolic-ref --quiet --short HEAD 2>/dev/null)
case $? in
  0) identity="branch:$branch" ;;
  1)
    hash=$(sf_capped "$deadline" git rev-parse --verify HEAD 2>/dev/null) || exit 0
    identity="commit:$hash"
    ;;
  *) exit 0 ;;
esac
commits=$(sf_capped "$deadline" git log --oneline -5 2>/dev/null)
probe_status=$?
(( probe_status != 124 )) || exit 0
(( probe_status == 0 )) || commits=''
git_status=$(sf_capped "$deadline" git status --short 2>/dev/null)
probe_status=$?
(( probe_status != 124 )) || exit 0
(( probe_status == 0 )) || git_status=''

jq -cn --arg identity "$identity" \
  '{state:[{name:"git/identity",value:$identity}]}' >&3 || exit 1
case $identity in
  branch:*) print -r -- "Git branch: ${identity#branch:}" ;;
  commit:*) print -r -- "Git commit: ${identity#commit:} (detached HEAD)" ;;
esac
print -r -- $'Recent commits:
'"$commits"
print -r -- $'Git status:
'"$(print -r -- "$git_status" | head -10)"
exit 0

{
  "render": {"initial_user_text":"${name} · Running shell command…","user_text":"${name}\n${output.stdout}${output.stderr}","model_text":"${output.stdout}"},
  "match": {
    "pattern": "^![^\\n]*\\z"
  },
  "help": {
    "usage": "!COMMAND",
    "description": "Run COMMAND and stage its output as context"
  }
}

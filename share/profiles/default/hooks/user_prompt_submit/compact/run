#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset submitted draft='' instruction request summary boundary context created base candidate
typeset transcript
typeset -a argv
integer explicit=0 suffix=1

fail_compaction() {
  print -u2 -r -- "$1"
  (( ! explicit )) || print -ru3 -- '{"action":"block"}'
  exit 0
}

submitted=$(cat; printf x)
submitted=${submitted%x}

case $submitted in
  /compact)
    explicit=1
    ;;
  *)
    draft=$submitted
    ;;
esac

boundary="$SHELLFISH_TURN_STATE/compact-boundary.json"
if ! jq -ce -s '
  ([.[] | select(.type == "user")] | first) as $first |
  ([.[] | select(.type == "assistant")] | last) as $last |
  ([$last.content[]? | select(.type == "text") | .text] | join("")) as $reply |
  select($first != null and $last != null) |
  {first_user_message:$first.content[0].text, final_assistant_response:$reply}
' "$SHELLFISH_SESSION" >"$boundary" 2>/dev/null; then
  fail_compaction 'nothing to compact yet'
fi

[[ -r ${0:A:h}/compact.md ]] && instruction=$(<"${0:A:h}/compact.md") || {
  fail_compaction 'cannot read compaction prompt; keeping the original'
}
request=$(jq -cn --arg text "$instruction" \
  '{type:"user",content:[{type:"text",text:$text}]}') || {
  fail_compaction 'cannot prepare summary request; keeping the original'
}
source "${0:A:h:h:h:h}/lib/hook.zsh" && sf_hook_draft 'compact · Compacting conversation…' ||
  fail_compaction 'cannot report compaction progress; keeping the original'
summary=$({ cat -- "$SHELLFISH_SESSION"; print -r -- "$request"; } |
  "$SHELLFISH_EXECUTABLE" backend-request |
  jq -er '[.content[] | select(.type == "text") | .text] | join("") |
    select(test("[^[:space:]]"))') || {
  fail_compaction 'cannot summarize session; keeping the original'
}

context="$SHELLFISH_TURN_STATE/compact-context"
if ! jq -nerj --slurpfile boundary "$boundary" \
  --rawfile summary <(print -rn -- "$summary") '
  $boundary[0] as $boundary |
  "<compacted_context>\n\n" +
  "The conversation before this point was compacted into the context below.\n\n" +
  "<first_user_message>\n" + $boundary.first_user_message +
  "\n</first_user_message>\n\n" +
  "<timeline>\n" + $summary + "\n</timeline>\n\n" +
  "<final_assistant_response>\n" + $boundary.final_assistant_response +
  "\n</final_assistant_response>\n\n" +
  "</compacted_context>"
' >"$context"; then
  fail_compaction 'cannot assemble compacted context; keeping the original'
fi

created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || {
  fail_compaction 'cannot create compacted session; keeping the original'
}
transcript="$SHELLFISH_TURN_STATE/compact.jsonl"
# Startup records without state, then every state record in source order, so the
# child reconstructs the same effective state without interpreting names.
if ! jq -ce -s --rawfile context "$context" --arg created "$created" '
    . as $records |
    ([$records | to_entries[] |
      select(.value.type == "user" or .value.type == "assistant") | .key] | first) as $start |
    select($start != null) |
    ($records[0:$start] | .[0].created = $created) as $startup |
    ($startup[] | select(.type != "state")),
    ($records[] | select(.type == "state")),
    # Carried startup hooks keep their identifiers, so continue past them.
    (([$startup[] | select(.type == "hook_result") | .id | tonumber] | max // 0) + 1 |
      tostring) as $id |
    {type:"hook_result",lifecycle:"session_start",id:$id,
      model_text:("<context script=\"compact\">\n" + $context + "\n</context>")}
  ' "$SHELLFISH_SESSION" >"$transcript"; then
  fail_compaction 'cannot create compacted session; keeping the original'
fi

base=${SHELLFISH_SESSION%.jsonl}
base=${base%_compact(|_<->)}
candidate="${base}_compact.jsonl"
while true; do
  if (umask 077; setopt no_clobber; cat -- "$transcript" >"$candidate") 2>/dev/null; then
    break
  fi
  if [[ ! -e $candidate && ! -L $candidate ]]; then
    fail_compaction 'cannot create compacted session; keeping the original'
    exit $?
  fi
  candidate="${base}_compact_${suffix}.jsonl"
  (( suffix++ ))
done

argv=( "$SHELLFISH_EXECUTABLE" --session "$candidate" )
[[ -z $draft ]] || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
exit 0

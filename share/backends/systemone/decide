#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail
umask 077

source "${0:A:h:h}/_backend.zsh"

api_key=${TYPESAFE_API_KEY-}
unset TYPESAFE_API_KEY

sf_backend_setup systemone
trap 'rm -rf -- "$SF_BACKEND_TEMP_DIR"' EXIT
cat >"$SF_BACKEND_REQUEST_FILE"

sf_backend_request '.request | all(keys[]; IN("state", "questions", "assets") | not)' ||
  sf_backend_die 'invalid request'
jq -e 'all(.input[]; .type != "video")' "$SF_BACKEND_REQUEST_FILE" >/dev/null ||
  sf_backend_die 'video input is not supported'
jq -e 'all(.input[]; .type != "image" or (.url | test("^data:image/(png|jpe?g);base64,")))' \
  "$SF_BACKEND_REQUEST_FILE" >/dev/null ||
  sf_backend_die 'images must be PNG or JPEG data URIs'

sf_backend_credential 'Authorization' "${api_key:+Bearer $api_key}"
unset api_key

# Placeholders are replaced wherever they appear, so a nonce keeps quoted text
# from naming an image.
nonce=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')

jq -ce --arg nonce "$nonce" '
  (reduce .input[] as $block ({state:[], assets:{}};
    if $block.type == "text" then .state += [$block.text]
    elif $block.type == "json" then .state += [$block.data]
    else
      "<image-\($nonce)-\(.assets | length + 1)>" as $key |
      ($block.url | split(",")) as [$head, $data] |
      .state += [$key] |
      .assets[$key] = {type:"image",
        format:($head | ltrimstr("data:image/") | rtrimstr(";base64")), data_base64:$data}
    end)) as $media |
  .request + {
    state:((if .system == "" then [] else [{system:.system}] end) + $media.state),
    questions:(.questions | map_values(
      if .type == "predicate" then {type:"noul", instructions} +
        if has("criteria") then {criteria} else {} end
      elif .type == "choice" then {type, instructions, criteria:.choices}
      else {type, instructions, criteria:.levels} end))
  } + if $media.assets == {} then {} else {assets:$media.assets} end
' "$SF_BACKEND_REQUEST_FILE" >"$SF_BACKEND_BODY_FILE" || sf_backend_die 'cannot translate request'

sf_backend_curl_args
! jq -e 'has("assets")' "$SF_BACKEND_BODY_FILE" >/dev/null ||
  SF_BACKEND_CURL_ARGS+=(--header 'TypeSafe-Danger-Zone-Images: true')
sf_backend_stream \
  '.error.message? // (.detail? |
    if type == "string" then . elif type == "array" then .[0].msg? else null end)' '
  [inputs] | join("\n") | fromjson |
  if (.answers | type == "object") and (.model | type == "string") then .
  else error("unsupported response") end |
  {
    model,
    answers:(.answers | map_values(
      if .type == "noul" then {type:"predicate", probability:.noul}
      elif .type == "choice" then {type, choice, confidence, probabilities}
      elif .type == "score" then {type, score, confidence,
        probabilities:[.probabilities | to_entries | sort_by(.key | tonumber)[] | .value]}
      else error("unsupported answer type") end))
  } + if .usage == null then {} else
    {usage:{input_tokens:.usage.input_tokens, output_tokens:.usage.output_tokens}} end'

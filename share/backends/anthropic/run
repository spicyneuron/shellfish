#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail
umask 077

source "${0:A:h:h}/_backend.zsh"

api_key=${ANTHROPIC_API_KEY-}
unset ANTHROPIC_API_KEY

sf_backend_setup anthropic
trap 'rm -rf -- "$SF_BACKEND_TEMP_DIR"' EXIT
cat >"$SF_BACKEND_REQUEST_FILE"

sf_backend_request || sf_backend_die 'invalid request'

sf_backend_credential 'x-api-key' "$api_key"
unset api_key

jq -ce '
  def flush_results:
    if (.pending | length) == 0 then .
    else .out += [{role:"user",content:.pending}] | .pending = []
    end;
  # The API refuses an empty text block and a message holding no content at all,
  # and a transcript is free to contain both: a response cancelled before it said
  # anything, or one whose only content was thinking that cannot be replayed.
  # A record is permanent, so sending one the API rejects would break every later
  # request too. A message that maps to nothing says so instead.
  # Applied once calls have rejoined their message, so a call-only response is
  # not mistaken for an empty one.
  def blocks:
    map(if (.content | length) == 0
        then .content = [{type:"text",text:"[no content]"}] else . end);
  def regular_message:
    if .type == "user" then
      {role:"user",content:[.content[] |
        select(.type == "text" and .text != "") | {type:"text",text:.text}]}
    elif .type == "assistant" then
      {role:"assistant",content:[.content[] |
        if .type == "text" then (select(.text != "") | {type:"text",text:.text})
        # Thinking is only accepted back with the signature it was issued with,
        # so a block that lost its payload is dropped rather than reconstructed
        # unsigned. Order is preserved, which keeps thinking ahead of the text
        # and tool calls the API expects it to precede.
        elif .type == "reasoning" then (.opaque // empty)
        else error("unsupported assistant content") end]}
    else
      error("unsupported canonical type")
    end;
  (.request |
    if has("response_schema") then
      .response_schema as $schema |
      del(.response_schema) |
      .output_config = ((.output_config // {}) +
        {format:{type:"json_schema",schema:$schema}})
    else . end |
    if has("reasoning_effort") then
      .reasoning = ((.reasoning // {}) + {effort:.reasoning_effort}) |
      del(.reasoning_effort)
    else . end |
    if has("reasoning") then
      .reasoning as $reasoning | del(.reasoning) |
      .thinking={type:"adaptive"} |
      if $reasoning.effort == null then del(.output_config.effort)
      else .output_config = ((.output_config // {}) + {effort:$reasoning.effort})
      end
    else . end |
    (if has("max_output_tokens") then .max_output_tokens
     elif has("max_completion_tokens") then .max_completion_tokens
     elif has("max_tokens") then .max_tokens
     else 16384 end) as $max_tokens |
    del(.max_tokens,.max_output_tokens,.max_completion_tokens) |
    .max_tokens=$max_tokens) as $request |
  (reduce .messages[] as $message ({out:[],pending:[]};
    if $message.type == "tool_result" then
      .pending += [{
        type:"tool_result",
        tool_use_id:$message.call_id,
        content:$message.content,
        is_error:(($message.exit_code // 0) != 0)
      }]
    # A call rejoins the assistant message that requested it. Results stay
    # pending meanwhile, so they still batch into one user message after it.
    elif $message.type == "tool_call" then
      .out[-1].content += [{type:"tool_use",
        id:$message.id,name:$message.name,input:$message.input}]
    else
      flush_results | .out += [($message | regular_message)]
    end
  ) | flush_results | .out | blocks) as $messages |
  ($request * {model:$request.model,messages:$messages,stream:true} +
   (if .system == "" then {} else {system:.system} end) +
   (if (.tools | length) == 0 then {} else {
      tools:[.tools[] | {name:.name,description:.description,input_schema:.input_schema}]
    } end))
' "$SF_BACKEND_REQUEST_FILE" >"$SF_BACKEND_BODY_FILE" || sf_backend_die 'cannot translate canonical request'

sf_backend_curl_args
SF_BACKEND_CURL_ARGS+=(--header 'anthropic-version: 2023-06-01')
sf_backend_stream '.error.message?' --arg control "$SF_BACKEND_CONTROL_PATTERN" '
  def preview($type;$text): {type:$type,text:$text};
  def usage:
    {input_tokens:((.input_tokens // 0) + (.cache_read_input_tokens // 0) +
       (.cache_creation_input_tokens // 0)),
     output_tokens:(.output_tokens // 0)} +
    (if (.cache_read_input_tokens // null) == null then {}
     else {cached_tokens:.cache_read_input_tokens} end) +
    (if (.output_tokens_details.thinking_tokens // null) == null then {}
     else {reasoning_tokens:.output_tokens_details.thinking_tokens} end);

  # Blocks are rebuilt into the shapes a non-streaming response carries, so what
  # follows is the normalization a buffered body would have gone through.
  def rebuilt:
    [.order[] as $index |
      .blocks[$index] |
      if .type == "tool_use" then
        {type:"tool_use", id:.id, name:.name,
         input:(if .partial == "" then {} else (.partial | fromjson) end)}
      elif .type == "thinking" then
        {type:"thinking", thinking:.thinking, signature:.signature}
      elif .type == "redacted_thinking" then {type:"redacted_thinking", data:.data}
      else {type:"text", text:.text}
      end];
  # The complete response, with thinking kept whole so it can be replayed. A
  # response cut short by the output limit drops its calls.
  def response($content):
    (if .stop_reason == "tool_use" then "tool_calls"
     elif .stop_reason == "max_tokens" then "length"
     elif .stop_reason == "end_turn" or .stop_reason == "stop_sequence" then "end"
     else error("unsupported stop reason") end) as $stop |
    {type:"assistant", stop:$stop,
     content:[$content[] |
       if .type == "text" then {type:"text",text:.text}
       elif .type == "thinking" then {type:"reasoning",text:.thinking,opaque:.}
       elif .type == "redacted_thinking" then {type:"reasoning",text:"",opaque:.}
       elif .type == "tool_use" then
         if $stop == "length" then empty
         else {type:"tool_call",id:.id,name:.name,input:.input} end
       else error("unsupported content block") end]} +
    (if .usage == null then {} else {usage:(.usage | usage)} end);

  # A null line ends the stream. A body that never announced itself as a stream
  # is taken whole there, so a provider that ignores the requested streaming mode
  # still normalizes; anything else that reaches the end unfinished is caught.
  foreach (inputs, null) as $line (
    {blocks:{}, order:[], usage:null, stop_reason:null, mode:null, body:"",
     pending:"", mark:null, done:false, out:[]};
    .out = [] |
    if $line == null then
      if .done then .
      elif .mode != "json" then error("no completed response")
      else (.body | try fromjson catch null) as $body |
        if $body == null then error("no completed response")
        else .done = true | .out += [$body | response(.content // [])]
        end
      end
    else
      ($line | sub("\r$"; "")) as $clean |
      (if .mode == null and ($clean | test("\\S")) then
         .mode = (if ($clean | test("^(data|event|id|retry):|^:"))
                  then "sse" else "json" end)
       else . end) |
      (if .mode == "json" then .body += ($line + "\n") else . end) |
      (if ($clean | startswith("data:")) then
         ($clean | sub("^data:[ ]?"; "") | fromjson? // {type:"ignore"})
       else {type:"ignore"}
       end) as $event |
      (($event.index // 0) | tostring) as $key |
      if $event.type == "error" then
        error(($event.error.message // "API error") | gsub($control; "�"))
      elif $event.type == "message_start" then
        .usage = ($event.message.usage // null)
      elif $event.type == "content_block_start" then
        .order += [$key] |
        .blocks[$key] = ($event.content_block +
          (if $event.content_block.type == "tool_use" then {partial:""} else {} end))
      elif $event.type == "content_block_delta" then
        $event.delta as $delta |
        if $delta.type == "text_delta" then
          .blocks[$key].text += $delta.text |
          .out += [preview("_assistant_message_delta";$delta.text)]
        elif $delta.type == "thinking_delta" then
          .blocks[$key].thinking += $delta.thinking |
          .out += [preview("_assistant_reasoning_delta";$delta.thinking)]
        elif $delta.type == "signature_delta" then
          .blocks[$key].signature += $delta.signature
        elif $delta.type == "input_json_delta" then
          .blocks[$key].partial += $delta.partial_json
        else .
        end
      elif $event.type == "message_delta" then
        .stop_reason = ($event.delta.stop_reason // .stop_reason) |
        # Merged rather than assigned, since the input count arrived at the start
        # and only the output count is settled here. Absent entirely, usage stays
        # unset so the turn reports nothing rather than reporting zero.
        (if ($event.usage // null) == null then .
         else .usage = ((.usage // {}) + $event.usage) end)
      elif $event.type == "message_stop" then
        .done = true |
        .out += [response(rebuilt)]
      else .
      end
    end;
    .out[]
  )'

#!/usr/bin/env zsh

emulate -R zsh
setopt err_exit no_aliases no_multios pipe_fail
umask 077

source "${0:A:h:h}/_backend.zsh"

api_key=${OPENAI_API_KEY-}
unset OPENAI_API_KEY

sf_backend_setup openai
trap 'rm -rf -- "$SF_BACKEND_TEMP_DIR"' EXIT
cat >"$SF_BACKEND_REQUEST_FILE"
sf_backend_request || exit 10

sf_backend_credential 'Authorization' "${api_key:+Bearer $api_key}"
unset api_key

typeset endpoint=${SF_BACKEND_ENDPOINT%/}
typeset models_endpoint context
case $endpoint in
  */chat/completions) models_endpoint="${endpoint%/chat/completions}/models" ;;
  */responses) models_endpoint="${endpoint%/responses}/models" ;;
  *) models_endpoint="${endpoint:h:h}/models" ;;
esac
sf_backend_context_curl_args "$models_endpoint"
context=$(curl "${SF_BACKEND_CURL_ARGS[@]}" 2>/dev/null | \
  jq -ce --arg model "$SF_BACKEND_MODEL" '
    first(.data[]? | select(.id == $model) | .context_length) |
    select(type == "number" and floor == . and . >= 1 and . <= 2147483647) |
    {context_window:.}
  ' 2>/dev/null) || exit 10
print -r -- "$context"

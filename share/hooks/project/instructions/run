#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_multios pipe_fail

typeset name text
for name in AGENTS.md CLAUDE.md; do
  [[ -f $name && -r $name ]] || continue
  text=$(cat -- "$name" && print x) || exit 1
  text=${text%x}
  print -rn -- "Project instructions ($name):"$'\n'"$text" >&2
  print -r -- "<context script=\"project/instructions\">"
  print -r -- "$name: Follow the instructions below for this directory tree. Do not reread this file. A nested $name takes precedence."
  print -rn -- $'\n'"$text"$'\n'"</context>"
  exit
done

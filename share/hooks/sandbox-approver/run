#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

# Input bytes: 32768 tokens at about four bytes each.
integer budget=$(( 32768 * 4 ))
# A decision review allows a call at this probability of sufficient
# authorization, and denies one this likely driven by untrusted instructions.
# Configuration may override the allow threshold.
local allow_threshold=0.8 injected_threshold=0.5
local request header system base records context candidate state_name=''
local model decision_model selection policy=${0:A:h}/policy.json
local settings='{"request":{"max_output_tokens":4096,"response_schema":{
  "type":"object","additionalProperties":false,
  "required":["risk","authorization","reason"],
  "properties":{
    "risk":{"enum":["low","medium","high"]},
    "authorization":{"enum":["low","medium","high","unknown"]},
    "reason":{"type":"string","minLength":1,"maxLength":1000}
  }
}}}'
local -a candidates overrides

# A failed review takes no action, so the request falls back to the user. The
# optional second argument is the review's raw content.
permission_defer() {
  local reason=${1//$'\n'/ } control
  reason=${reason//$'\r'/ }
  reason=${reason[1,1000]}
  if [[ -n $state_name ]]; then
    control=$(jq -cn --arg name "$state_name" --arg reason "$reason" \
        --arg content "$2" --argjson content_set $(( $# > 1 )) '
      {state_update:[{name:$name,value:{
        content:(if $content_set == 1 then $content else null end),reason:$reason}}]}
    ') || exit 1
    print -r -u3 -- "$control" || exit 1
  fi
  print -r -u2 -- "Review failed, asking the user: $reason"
  exit 0
}

# Emits an outcome: {action:"allow"|"deny", reason, content}.
permission_resolve() {
  local outcome=$1 control
  control=$(jq -c --arg name "$state_name" '
    {state_update:[{name:$name,value:{content,reason}}], action} +
    (if .action == "deny" then {reason} else {} end)
  ' <<<"$outcome") || exit 1
  print -r -u3 -- "$control" || exit 1
  jq -r '(if .action == "allow" then "Approved: " else "Denied: " end) + .reason' \
    <<<"$outcome" >&2
  exit 0
}

# Classifies with a chat model through a temporary session and sets REPLY to
# the outcome.
review_chat() {
  local transcript="$SHELLFISH_TURN_STATE/permission-review.jsonl" response content result
  if ! jq -cn --argjson header "$header" --arg system "$system" --argjson context "$base" \
      --argjson settings "$settings" '
    ($header | del(.model.request.response_schema) | .model *= $settings |
      .profile |= (.system=[{text:$system}] | .tools=[] | .hooks=[] |
        .sandbox={enabled:false, read:[], write:[]})),
    {type:"user",content:[{type:"text",text:($context | tojson)}]}
  ' >"$transcript"; then
    permission_defer 'Permission review could not construct its temporary session.'
  fi

  response=$("$SHELLFISH_EXECUTABLE" request "${overrides[@]}" \
    <"$transcript" 2>/dev/null) ||
    permission_defer 'Permission review provider request failed.'

  content=$(jq -er '
    select(type == "object" and .type == "assistant" and .stop == "end" and
      ([.content[] | select(.type == "text")] | length) == 1) |
    [.content[] | select(.type == "text")][0].text
  ' <<<"$response" 2>/dev/null) ||
    permission_defer 'Permission review returned an invalid classification.'
  result=$(jq -ncer --arg content "$content" '
    $content | gsub("^\\s+|\\s+$"; "") | fromjson |
    select(type == "object" and keys == ["authorization","reason","risk"] and
      (.risk | IN("low","medium","high")) and
      (.authorization | IN("low","medium","high","unknown")) and
      (.reason | type == "string" and length > 0 and length <= 1000 and
        (test("[[:cntrl:]]") | not)))
  ' 2>/dev/null) ||
    permission_defer 'Permission review returned an invalid classification.' "$content"

  REPLY=$(jq -c --arg content "$content" '
    {low:1,medium:2,high:3} as $rank |
    {action:(if .authorization != "unknown" and $rank[.authorization] >= $rank[.risk]
      then "allow" else "deny" end), reason, content:$content}
  ' <<<"$result") || exit 1
}

# Classifies with a decision model and sets REPLY to the outcome. Allowing
# requires authorization at or above risk; unknown authorization covers nothing.
review_decide() {
  local result
  result=$(jq -c --argjson context "$base" '
    {system:.preamble, input:[{type:"json",data:$context}], questions:{
      risk:(.risk | {type:"score",instructions,levels}),
      authorization:(.authorization | {type:"score",instructions,levels}),
      injected:({type:"predicate"} + .injected)}}
  ' "$policy" | "$SHELLFISH_EXECUTABLE" decide -m "$decision_model" 2>/dev/null) ||
    permission_defer 'Permission review decision request failed.'
  jq -e 'all(.answers[]; .type != "refusal")' <<<"$result" >/dev/null 2>&1 ||
    permission_defer 'Permission review decision model refused to answer.' "$result"

  REPLY=$(jq -c --argjson allow "$allow_threshold" --argjson injected "$injected_threshold" '
    def dist: .probabilities | add as $sum | map(. / $sum);
    def percent: . * 100 | round | tostring + "%";
    tojson as $content |
    (.answers.risk | dist) as $risk | (.answers.authorization | dist) as $auth |
    ([range(4) as $a | range(3) as $r | select($a > $r) | $auth[$a] * $risk[$r]] | add) as $p |
    if .answers.injected.probability >= $injected then
      {action:"deny", reason:"Appears driven by instructions in untrusted data (\(
        .answers.injected.probability | percent))."}
    else
      {action:(if $p >= $allow then "allow" else "deny" end),
        reason:"\($p | percent) likely authorized."}
    end + {content:$content}
  ' <<<"$result" 2>/dev/null) ||
    permission_defer 'Permission review returned an invalid decision.' "$result"
}

[[ -r $SHELLFISH_SESSION && -d $SHELLFISH_TURN_STATE ]] ||
  permission_defer 'Permission review could not read the active turn.'

request=$(jq -ce --argjson turn "$SHELLFISH_TURN_ID" --arg name "$1" --arg id "$2" '
  select(type == "object" and (.tool_input | type == "object")) |
  {turn_id:$turn,tool:{name:$name,id:$id,input:.tool_input}}
' 2>/dev/null) || permission_defer 'Permission review received an invalid tool request.'
state_name=$(jq -r --argjson turn "$SHELLFISH_TURN_ID" '
  "permissions/\($turn)/\(.tool.id)"
' <<<"$request") || permission_defer 'Permission review could not prepare state.'
if (( ${#state_name} > 128 )); then
  state_name=''
  permission_defer 'Permission review cannot store this tool request identifier.'
fi

system=$(jq -r '
  [.preamble,
    (.risk, .authorization | .instructions + "\n\n" + (.levels | map("- " + .) | join("\n"))),
    "Return only one JSON object with exactly these fields:\n" +
      "{\"risk\":\"low|medium|high\",\"authorization\":\"unknown|low|medium|high\",\"reason\":\"...\"}",
    .reason] | join("\n\n")
' "$policy" 2>/dev/null) ||
  permission_defer 'Permission review could not load its policy.'

header=$(head -n 1 -- "$SHELLFISH_SESSION") ||
  permission_defer 'Permission review could not inspect the session header.'
selection=$(jq -r '
  def name: type == "string" and
    test("^[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)*$");
  (.profile.config // {}) |
  if has("sandbox-approver") then .["sandbox-approver"] else {} end |
  if type == "object" and (keys - ["allow_threshold", "decision_model", "model"]) == [] and
    ((has("model") and has("decision_model")) | not) and
    ((has("allow_threshold") | not) or has("decision_model")) and
    ((has("model") | not) or (.model | name)) and
    ((has("decision_model") | not) or (.decision_model | name)) and
    ((has("allow_threshold") | not) or
      (.allow_threshold | type == "number" and . > 0 and . <= 1))
  then to_entries[] | "\(.key) \(.value)"
  else error("invalid config.sandbox-approver") end
' <<<"$header" 2>/dev/null) || permission_defer 'Permission review has invalid configuration.'
while read -r name value; do
  case $name in
    model) model=$value ;;
    decision_model) decision_model=$value ;;
    allow_threshold) allow_threshold=$value ;;
  esac
done <<<"$selection"
# Dropping the model's own schema keeps the merge from adding its properties.
[[ -z $model ]] || overrides=( --model "$model"
  --model '{"request":{"response_schema":null}}' --model "$settings" )

# The first user message retains startup context. Later messages are admitted
# backward without gaps, then emitted chronologically.
records=$(jq -cs --argjson request "$request" '
  def render_context:
    if type == "string" then .
    else
      "<hook name=\"" + (.lifecycle | @html) + "\">\n" +
      ([.texts[] | if endswith("\n") then . else . + "\n" end] | add) + "</hook>"
    end;
  def join_context($parts): [$parts[] | select(. != "") | render_context] | join("\n\n");
  def context_message($context; $text):
    {type:"user",content:[{type:"text",text:join_context([$context[], $text])}]};
  def add_context($record):
    ([to_entries[] | select(.value.lifecycle? == $record.lifecycle) | .key] | first) as $index |
    if $index == null then . + [{lifecycle:$record.lifecycle,texts:[$record.model_text]}]
    else .[$index].texts += [$record.model_text] end;
  . as $records |
  (reduce $records[1:][] as $record
    ({messages:[],context:[],calls:[],response:null};
      if $record.type == "state_update" then .
      elif $record.type == "hook_result" then
        if ($record.model_text // "") == "" then . else .context |= add_context($record) end
      elif $record.type == "error" then .calls=[] | .response=null
      elif $record.type == "user" then
        .messages += [context_message(.context;$record.content[0].text)] | .context=[]
      elif $record.type == "assistant" then
        (if (.context | length) == 0 then .
         else .messages += [context_message(.context;"")] | .context=[] end) |
        ([$record.content[] | select(.type == "tool_call")]) as $calls |
        if ($calls | length) == 0 then .messages += [$record | del(.usage)]
        else .calls=$calls | .response=$record end
      elif $record.type == "tool_result" then
        .calls[0] as $call |
        (if .response == null then . else
          .messages += [.response | del(.usage) |
            .content=[.content[] | select(.type != "tool_call")]] | .response=null end) |
        .messages += [
          {type:"tool_call",id:$call.id,name:$call.name,input:$call.input},
          {type:"tool_result",call_id:$call.id,name:$call.name,
            exit_code:$record.exit_code,content:join_context([.context[],($record.model_text // "")])}
        ] | .context=[] | .calls=.calls[1:]
      else . end)) as $state |
  ($state.messages + if ($state.context | length) == 0 then []
    else [context_message($state.context;"")] end | to_entries) as $entries |
  ([ $entries[] | select(.value.type == "user") | .key ] | first) as $first_user |
  select($first_user != null) |
  {
    system_message:$records[0].profile.system[0].text,
    startup_context:$entries[$first_user].value,
    target_tool_call:{type:"tool_call",id:$request.tool.id,
      name:$request.tool.name,input:$request.tool.input},
    candidates:([
      ($entries[] | select(.key > $first_user) | .value),
      ($state.response | select(. != null)) |
      if .type == "assistant" then
        {type,stop,content:[.content[] | select(.type == "text")]}
      else . end
    ] | reverse)
  }
' "$SHELLFISH_SESSION" 2>/dev/null) ||
  permission_defer 'Permission review could not project the active context.'

base=$(jq -cn --argjson records "$records" '
  {startup_context:$records.startup_context,recent_timeline:[],
   target_tool_call:$records.target_tool_call} +
  (if $records.system_message == null then {} else
    {system_message:$records.system_message} end)
') || permission_defer 'Permission review could not prepare context.'

integer base_bytes
base_bytes=$(jq -cn --arg system "$system" --argjson context "$base" \
  '($system | utf8bytelength) + ($context | tojson | utf8bytelength)') ||
  permission_defer 'Permission review could not measure required context.'
(( base_bytes <= budget )) ||
  permission_defer 'Required permission review context exceeds the review context limit.'

candidates=( "${(@f)$(jq -c '.candidates[]' <<<"$records")}" ) ||
  permission_defer 'Permission review could not inspect optional context.'
integer candidate_bytes
for candidate in $candidates; do
  context=$(jq -cn --argjson context "$base" --argjson candidate "$candidate" '
    $context | .recent_timeline = ([$candidate] + .recent_timeline)
  ') || permission_defer 'Permission review could not assemble context.'
  candidate_bytes=$(jq -cn --arg system "$system" --argjson context "$context" \
    '($system | utf8bytelength) + ($context | tojson | utf8bytelength)') ||
    permission_defer 'Permission review could not measure optional context.'
  (( candidate_bytes <= budget )) || break
  base=$context
done

if [[ -n $decision_model ]]; then review_decide; else review_chat; fi
permission_resolve "$REPLY"

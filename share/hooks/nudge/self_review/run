#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

local config policy system header context target settings response content result reason feedback
local model decision_model='' counter selection name value
local allow_threshold=0.8
integer max_input_kb=24 max_rejections=2 rejected=0
local -a overrides

finish_review() {
  print -r -u2 -- "$1"
  exit 0
}
failed_review() { finish_review "Review failed, letting the turn finish: $1"; }

[[ -r $SHELLFISH_SESSION && -d $SHELLFISH_TURN_STATE ]] ||
  failed_review 'Could not read the active turn.'
config=$(jq -ce '
  def name: type == "string" and
    test("^[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)*$");
  def positive: type == "number" and . == floor and . > 0;
  (.nudge // {}) | if has("self_review") then .self_review else {} end |
  select(type == "object" and
    (keys - ["model","decision_model","allow_threshold","max_input_kb","max_rejections","questions"]) == [] and
    ((has("model") and has("decision_model")) | not) and
    ((has("allow_threshold") | not) or has("decision_model")) and
    ((has("model") | not) or (.model | name)) and
    ((has("decision_model") | not) or (.decision_model | name)) and
    ((has("allow_threshold") | not) or (.allow_threshold | type == "number" and . > 0 and . <= 1)) and
    ((has("max_input_kb") | not) or (.max_input_kb | positive)) and
    ((has("max_rejections") | not) or (.max_rejections | positive)))
' <<<"${SHELLFISH_CONFIG:-{\}}" 2>/dev/null) || failed_review 'Invalid configuration.'
selection=$(jq -r 'del(.questions) | to_entries[] | "\(.key) \(.value)"' <<<"$config") ||
  failed_review 'Could not read configuration.'
while read -r name value; do
  case $name in
    model) model=$value ;;
    decision_model) decision_model=$value ;;
    allow_threshold) allow_threshold=$value ;;
    max_input_kb) max_input_kb=$value ;;
    max_rejections) max_rejections=$value ;;
  esac
done <<<"$selection"

counter="$SHELLFISH_TURN_STATE/self-review-rejections"
if [[ -e $counter ]]; then
  rejected=$(<"$counter")
  [[ $rejected == <0-> ]] || failed_review 'Invalid rejection counter.'
fi
(( rejected < max_rejections )) || finish_review "Rejection limit ($max_rejections) reached, letting the turn finish."

policy=$(jq -ce --argjson config "$config" '
  if $config | has("questions") then .questions=$config.questions else . end |
  select(.questions | type == "object" and length > 0 and all(to_entries[];
    (.key | test("^[A-Za-z][A-Za-z0-9_]*$")) and
    (.value | type == "object" and (keys - ["instructions","criteria","block_on","reminder"]) == [] and
      (.instructions | type == "string" and length > 0) and
      ((has("block_on") | not) or (.block_on | type == "boolean")) and
      ((has("reminder") | not) or (.reminder | type == "string" and length > 0)) and
      ((has("criteria") | not) or (.criteria | type == "object" and
        (keys - ["true","false"]) == [] and all(.[]; type == "string"))))))
' "${0:A:h}/policy.json" 2>/dev/null) || failed_review 'Invalid review questions.'
system=$(jq -r '
  .preamble + "\n\n" + (.questions | map_values(del(.reminder)) | tojson) +
  "\n\nAnswer every question with a boolean. Return only JSON with exactly two fields: answers (an object keyed like the questions) and reason (a nonempty explanation, at most 1000 characters, without control characters). A question blocks if its answer matches block_on (false if omitted). Explain any blocking question so the agent can correct its work."
' <<<"$policy") || failed_review 'Could not prepare review instructions.'
target=$(jq -Rsc '{target_assistant_text:.}') || failed_review 'Could not read final assistant text.'
context=$(jq -ces --argjson target "$target" --arg system "$system" \
  --argjson budget $(( max_input_kb * 1024 )) \
  "$(<"$SHELLFISH_SHARE_DIR/lib/review-context.jq")" "$SHELLFISH_SESSION" 2>/dev/null)
case $? in
  0) [[ -n $context ]] || failed_review 'Missing user context.' ;;
  3) failed_review 'Required context exceeds the review context limit.' ;;
  *) failed_review 'Could not filter the active context.' ;;
esac

if [[ -n $decision_model ]]; then
  result=$(jq -c --argjson context "$context" '
    {system:.preamble,input:[{type:"json",data:$context}],
      questions:(.questions | map_values(del(.block_on,.reminder) + {type:"predicate"}))}
  ' <<<"$policy" | "$SHELLFISH_EXECUTABLE" decide -m "$decision_model" 2>/dev/null) ||
    failed_review 'Decision request failed.'
  result=$(jq -ce --argjson policy "$policy" --argjson threshold "$allow_threshold" '
    select((.answers | keys) == ($policy.questions | keys) and
      all(.answers[]; .type == "predicate" and
        (.probability | type == "number" and . >= 0 and . <= 1))) |
    [.answers | to_entries[] | .key as $name | .value.probability as $yes |
      if $policy.questions[$name].block_on then
        # Compare the sum to avoid subtracting a probability at the threshold.
        {name:$name, pass:($yes + $threshold <= 1), likelihood:(1 - $yes)}
      else {name:$name, pass:($yes >= $threshold), likelihood:$yes} end
    ] as $checks |
    {blocked:[$checks[] | select(.pass | not) | .name],
      reason:($checks | map("\(.name): \(.likelihood * 100 | round)% likely satisfied") | join("; "))}
  ' <<<"$result" 2>/dev/null) || failed_review 'Invalid decision or refused question.'
else
  settings=$(jq -cn --argjson policy "$policy" '
    {request:{max_output_tokens:4096,response_schema:{type:"object",additionalProperties:false,
      required:["answers","reason"],properties:{
        answers:{type:"object",additionalProperties:false,required:($policy.questions | keys),
          properties:($policy.questions | map_values({type:"boolean"}))},
        reason:{type:"string",minLength:1,maxLength:1000}}}}}
  ') || failed_review 'Could not prepare response schema.'
  header=$(head -n 1 -- "$SHELLFISH_SESSION") || failed_review 'Could not read session header.'
  [[ -z $model ]] || overrides=( --model "$model"
    --model '{"request":{"response_schema":null}}' --model "$settings" )
  jq -cn --argjson header "$header" --arg system "$system" \
      --argjson context "$context" --argjson settings "$settings" '
    ($header | del(.model.request.response_schema) | .model *= $settings |
      .profile |= (.system=[{text:$system}] | .tools=[] | .hooks=[] |
        .sandbox={enabled:false,tools:{}})),
    {type:"user",content:[{type:"text",text:($context | tojson)}]}
  ' >"$SHELLFISH_TURN_STATE/self-review.jsonl" || failed_review 'Could not construct review session.'
  response=$("$SHELLFISH_EXECUTABLE" request "${overrides[@]}" \
    <"$SHELLFISH_TURN_STATE/self-review.jsonl" 2>/dev/null) || failed_review 'Provider request failed.'
  content=$(jq -er '
    select(.type == "assistant" and .stop == "end" and
      ([.content[] | select(.type == "text")] | length) == 1) |
    [.content[] | select(.type == "text")][0].text
  ' <<<"$response" 2>/dev/null) || failed_review 'Invalid review response.'
  result=$(jq -ncer --arg content "$content" --argjson policy "$policy" '
    $content | fromjson | select(type == "object" and keys == ["answers","reason"] and
      (.answers | type == "object" and keys == ($policy.questions | keys) and all(.[]; type == "boolean")) and
      (.reason | type == "string" and length > 0 and length <= 1000 and (test("[[:cntrl:]]") | not))) |
    {blocked:[.answers | to_entries[] |
      select(.value == ($policy.questions[.key].block_on // false)) | .key],reason}
  ' 2>/dev/null) || failed_review 'Invalid classification.'
fi

reason=$(jq -r .reason <<<"$result") || failed_review 'Could not read review reason.'
if jq -e '.blocked == []' <<<"$result" >/dev/null; then
  rm -f -- "$counter"
  finish_review "Approved: $reason"
fi
feedback=$(jq -er --argjson policy "$policy" '
  [.blocked[] | $policy.questions[.].reminder // empty] + [.reason] | join("\n")
' <<<"$result") || failed_review 'Could not prepare review feedback.'
print -r -- $(( rejected + 1 )) >"$counter" || failed_review 'Could not record rejection count.'
print -r -- "$feedback"
jq -cn --arg reason "$reason" '{action:"deny",reason:$reason}' >&3 || exit 1
finish_review "Denied: $reason"

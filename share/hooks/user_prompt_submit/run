#!/usr/bin/env zsh

# Dynamic prompt commands, automatic compaction, and the git identity check.
# Dynamic scripts receive the prompt on stdin.

emulate -R zsh
setopt no_aliases no_multios pipe_fail

typeset parts=${0:A:h:h} submitted
submitted=$(cat; printf x)
submitted=${submitted%x}

part() {
  print -rn -- "$submitted" | "$parts/$1"
  exit
}

[[ $submitted == *$'\n'* ]] || case $submitted in
  /fork|'/fork '*) part fork ;;
  /compact) part compact ;;
esac

# Compact automatically once the latest response nears the frozen window.
jq -es '
  .[0].profile.context_window as $window |
  ([.[] | select(.type == "assistant" and .usage != null)] | last) as $measured |
  $window != null and $measured != null and
  (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
' "$SHELLFISH_SESSION" >/dev/null 2>&1 && part compact
exec "$parts/git/change"

#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_bg_nice no_multios pipe_fail
source "$SHELLFISH_SHARE_DIR/lib/git-identity.zsh" || exit 1

typeset previous identity text from to
previous=$(jq -ers '
  [.[] | select(.type == "state_update" and .name == "git/identity")][-1].value |
  select(type == "string")
' "$SHELLFISH_SESSION" 2>/dev/null) || exit 0
typeset -F deadline=$(( EPOCHREALTIME + SF_PROBE_BUDGET ))
identity=$(sf_git_identity "$deadline") || exit 0
[[ $identity != "$previous" ]] || exit 0

case "$previous -> $identity" in
  branch:*' -> branch:'*)
    text="Git branch changed from ${previous#branch:} to ${identity#branch:}."
    ;;
  *)
    text="Git identity changed from $previous to $identity."
    ;;
esac
from=${previous#*:}
to=${identity#*:}
[[ $previous != commit:* ]] || from="detached commit $from"
[[ $identity != commit:* ]] || to="detached commit $to"
sf_git_save_identity "$identity" || exit 1
print -rn -- "**Git checkout changed**"$'\n'"$from → $to" >&2
print -rn -- "$text"

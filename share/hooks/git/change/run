#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_bg_nice no_multios pipe_fail
zmodload zsh/datetime
source "${0:A:h:h:h:h}/lib/capped.zsh" || exit 1

typeset previous branch hash identity text from to
previous=$(jq -ers '
  [.[] | select(.type == "state" and .name == "git/identity")][-1].value |
  select(type == "string")
' "$SHELLFISH_SESSION" 2>/dev/null) || exit 0
typeset -F deadline=$(( EPOCHREALTIME + SF_PROBE_BUDGET ))
branch=$(sf_capped "$deadline" git symbolic-ref --quiet --short HEAD 2>/dev/null)
case $? in
  0) identity="branch:$branch" ;;
  1)
    hash=$(sf_capped "$deadline" git rev-parse --verify HEAD 2>/dev/null) || exit 0
    identity="commit:$hash"
    ;;
  *) exit 0 ;;
esac
[[ $identity != "$previous" ]] || exit 0

case "$previous -> $identity" in
  branch:*' -> branch:'*)
    text="Git branch changed from ${previous#branch:} to ${identity#branch:}."
    ;;
  *)
    text="Git identity changed from $previous to $identity."
    ;;
esac
from=${previous#*:}
to=${identity#*:}
[[ $previous != commit:* ]] || from="detached commit $from"
[[ $identity != commit:* ]] || to="detached commit $to"
jq -cn --arg identity "$identity" --arg from "$from" --arg to "$to" '
  {state:[{name:"git/identity",value:$identity}],data:{from:$from,to:$to},
   user_text_done:"Git checkout changed:\n${data.from} → ${data.to}",
   model_text:"<context script=\"git/change\">\n${output.stdout}</context>"}
' >&3 || exit 1
print -r -- "$text"

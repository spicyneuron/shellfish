#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset submitted='' body operation candidate grant_path header grants updated profile field
typeset grant resolved matched=''
typeset action access message
typeset usage='usage: /sandbox {read|write|+read|+write|+r|+w|-read|-write|-r|-w} DIR'
integer read_status
IFS= read -r submitted
read_status=$?

case "$read_status:$submitted" in
  1:/sandbox)
    IFS= read -r header <"$SHELLFISH_SESSION" || exit 1
    jq -r '
      "Sandbox: " + (if .profile.sandbox then "enabled" else "disabled" end),
      "Read grants:",
      (if .profile.sandbox_read_paths | length == 0 then "  (none)"
       else .profile.sandbox_read_paths[] | "  " + . end),
      "Write grants:",
      (if .profile.sandbox_write_paths | length == 0 then "  (none)"
       else .profile.sandbox_write_paths[] | "  " + . end)
    ' <<<"$header" >&2 || exit 1
    print -ru3 -- '{"action":"block"}'
    exit 0
    ;;
  1:'/sandbox '*) body=${submitted#'/sandbox '} ;;
  *) exit 0 ;;
esac

print -ru3 -- '{"action":"block"}'

body=${body##[[:space:]]#}
body=${body%%[[:space:]]#}
operation=${body%%[[:space:]]*}
candidate=${body#"$operation"}
candidate=${candidate##[[:space:]]#}
candidate=${candidate%%[[:space:]]#}
case $operation in
  read|+read|+r) action=add; access=read ;;
  write|+write|+w) action=add; access=write ;;
  -read|-r) action=remove; access=read ;;
  -write|-w) action=remove; access=write ;;
  *)
    print -u2 -r -- "$usage"
    exit 0
    ;;
esac
[[ -n $candidate ]] || {
  print -u2 -r -- "$usage"
  exit 0
}

IFS= read -r header <"$SHELLFISH_SESSION" || exit 1
jq -e '.profile.sandbox == true' <<<"$header" >/dev/null || {
  print -u2 -r -- 'session sandbox is disabled'
  exit 0
}
field="sandbox_${access}_paths"
grants=$(jq -ce --arg field "$field" '.profile[$field] | select(type == "array")' \
  <<<"$header") || exit 1

if [[ $candidate == '~' || $candidate == '~/'* ]]; then
  [[ -n ${HOME-} ]] || {
    print -u2 -r -- 'cannot expand ~ without HOME'
    exit 0
  }
  candidate=${candidate/#\~/${HOME:A}}
elif [[ $candidate != /* ]]; then
  candidate="$PWD/$candidate"
fi

grant_path=${candidate:A}
if [[ $action == add && ! -d $grant_path ]]; then
  print -u2 -r -- "sandbox directory does not exist: $candidate"
  exit 0
fi

while IFS= read -r -d '' grant; do
  case $grant in
    '~/'*) resolved="${HOME:A}/${grant#\~/}" ;;
    *) resolved=$grant ;;
  esac
  [[ ${resolved:A} != $grant_path ]] || { matched=$grant; break; }
done < <(jq -jr '.[] | ., "\u0000"' <<<"$grants")

if [[ -n $matched ]]; then
  if [[ $action == add ]]; then
    print -u2 -r -- "sandbox $access grant already exists: $grant_path"
    exit 0
  fi
elif [[ $action == remove ]]; then
  print -u2 -r -- "sandbox $access grant is not set: $grant_path"
  exit 0
fi

updated=$(jq -c --arg action "$action" --arg path "$grant_path" --arg matched "$matched" '
  if $action == "add" then . + [$path] else map(select(. != $matched)) end
' <<<"$grants") || exit 1
profile=$(jq -c --arg field "$field" --argjson paths "$updated" \
  '.profile | .[$field]=$paths' <<<"$header") || exit 1
if [[ $action == add ]]; then
  message="Session sandbox $access grant added: $grant_path"
else
  message="Session sandbox $access grant removed: $grant_path"
fi
source "${0:A:h:h}/lib/hook.zsh" || exit 1
sf_hook_context sandbox "sandbox"$'\n'"$message" "$message" \
  "$(jq -cn --argjson profile "$profile" '{action:"session_update",profile:$profile}')"

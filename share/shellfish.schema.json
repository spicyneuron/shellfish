{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shellfish profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "extend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/reference"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "insecure_tls": {
          "type": "boolean"
        },
        "http_timeout": {
          "$ref": "#/$defs/positive_integer"
        },
        "http_stall": {
          "$ref": "#/$defs/positive_integer"
        }
      }
    },
    "tools": {
      "$ref": "#/$defs/component_list"
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_start": {
          "$ref": "#/$defs/component_list"
        },
        "user_prompt_submit": {
          "$ref": "#/$defs/component_list"
        },
        "permission_request": {
          "$ref": "#/$defs/component_list"
        },
        "pre_tool_use": {
          "$ref": "#/$defs/component_list"
        },
        "post_tool_use": {
          "$ref": "#/$defs/component_list"
        },
        "stop": {
          "$ref": "#/$defs/component_list"
        }
      }
    },
    "sandbox": {
      "type": "boolean"
    },
    "sandbox_read_paths": {
      "$ref": "#/$defs/sandbox_path_list"
    },
    "sandbox_write_paths": {
      "$ref": "#/$defs/sandbox_path_list"
    },
    "max_requests_per_turn": {
      "$ref": "#/$defs/positive_integer"
    },
    "max_tool_calls_per_request": {
      "$ref": "#/$defs/positive_integer"
    },
    "max_capture_bytes": {
      "$ref": "#/$defs/capture_bytes"
    },
    "system": {
      "$ref": "#/$defs/component_list"
    },
    "context_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/positive_integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^@?[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "capture_bytes": {
      "type": "integer",
      "minimum": 64,
      "maximum": 2147483647
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https?://[^\\s\u0000-\u001f\u007f-\u009f]+$"
    },
    "component_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "sandbox_path_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(/|~/)[^\u0000-\u001f\u007f-\u009f]*$"
      }
    }
  }
}

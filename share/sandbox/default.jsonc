// Shellfish sandbox: https://github.com/spicyneuron/shellfish
//
// Starter profiles select this file as "default". init copies it for customization.
// Paths are absolute, "~/" for HOME, "./" or "../" relative to this file, or "@"
// for the bundled root, and need not exist on every machine.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/sandbox.schema.json",

  // Setting false runs every tool with user permissions
  "enabled": true,

  // Seconds to wait for the user to approve a sandbox bypass before denying it
  "user_approval_timeout": 120,

  "read": [
    // Paths outside the project that sandboxed tools may read
  ],
  "write": [
    // Paths outside the project that sandboxed tools may read and write
  ]
}

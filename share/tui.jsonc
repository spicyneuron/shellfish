// Shellfish: https://github.com/spicyneuron/shellfish
//
// Default TUI settings. $XDG_CONFIG_HOME/shellfish/tui.jsonc is merged over
// this file. Nothing here is frozen into a session; a reopened session renders
// with whatever these say today.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/tui.schema.json",

  // Themes are hex color palettes. "auto" follows the terminal background;
  // "light"/"dark" force a mode. theme_light/theme_dark name which entry under
  // "themes" is used for each mode. A configured palette merges over the one
  // below, so it may set only the colors it changes.
  "theme_mode": "auto",
  "theme_light": "light",
  "theme_dark": "dark",
  "themes": {
    "light": {
      "muted": "#828e9f",
      "divider": "#d6dde3",
      "footer": "#828e9f",
      "prompt": "#d6dde3",
      "prompt_waiting": "#399ee6",
      "system": "#a37acc",
      "context": "#828e9f",
      "user": "#399ee6",
      "agent": "#fa8d3e",
      "activity": "#fa8d3e",
      "link": "#a37acc",
      "code": "#399ee6",
      "tool": "#828e9f",
      "reasoning": "#828e9f",
      "error": "#e65050",
      "syntax_comment": "#828e9f",
      "syntax_keyword": "#fa8d3e",
      "syntax_string": "#86b300",
      "syntax_number": "#a37acc",
      "syntax_tag": "#55b4d4",
      "diff_added": "#3f7f34",
      "diff_added_background": "#e2f4df",
      "diff_removed": "#b84f5b",
      "diff_removed_background": "#f8e1e3",
      "permission": "#399ee6"
    },
    "dark": {
      "muted": "#707a8c",
      "divider": "#3d444d",
      "footer": "#707a8c",
      "prompt": "#3d444d",
      "prompt_waiting": "#73d0ff",
      "system": "#dfbfff",
      "context": "#707a8c",
      "user": "#73d0ff",
      "agent": "#ffa759",
      "activity": "#ffa759",
      "link": "#dfbfff",
      "code": "#73d0ff",
      "tool": "#707a8c",
      "reasoning": "#707a8c",
      "error": "#ff6666",
      "syntax_comment": "#707a8c",
      "syntax_keyword": "#ffa759",
      "syntax_string": "#d5ff80",
      "syntax_number": "#dfbfff",
      "syntax_tag": "#5ccfe6",
      "diff_added": "#87d96c",
      "diff_added_background": "#12261e",
      "diff_removed": "#f27983",
      "diff_removed_background": "#2d1519",
      "permission": "#73d0ff"
    }
  },

  // Rows kept when collapsing output. "full" shows everything. A tool or hook
  // overrides the global limit with render.preview_lines. Disabled by --verbose.
  "preview_lines_reasoning": 0,
  "preview_lines": 2
}

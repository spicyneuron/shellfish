#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail
source "${0:A:h:h:h}/lib/compact.zsh" || exit 1

typeset split transcript
split=$(sf_compact_split) || sf_compact_fail 'Nothing to compact yet.'
transcript="$SHELLFISH_TURN_STATE/compact-tools.jsonl"
if ! jq -c -s --argjson split "$split" '
  . as $records |
  [to_entries[] |
    if .key >= $split.start and .key < $split.cut and .value.type == "tool_result" then
      .value |= (del(.model_content, .user_preview_lines) |
        .model_text = "[Result cleared]" |
        .user_text = .model_text)
    else . end | .value] |
  select(. != $records) | .[]
' "$SHELLFISH_SESSION" >"$transcript"; then
  sf_compact_fail 'Could not clear tool results. Original session kept.'
fi
[[ -s $transcript ]] || sf_compact_fail 'No older tool results to clear.'
sf_compact_handoff "$transcript" compact_tools ||
  sf_compact_fail 'Could not create compacted session. Original session kept.'

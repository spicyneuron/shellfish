#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset body tool operation candidate value header grants updated profile
typeset grant resolved matched=''
typeset action access label message user
typeset usage='usage: /sandbox [TOOL [{+read|+write|+domain|-read|-write|-domain} VALUE]]'
body=$(cat)
body=${body##[[:space:]]#}
body=${body%%[[:space:]]#}
IFS= read -r header <"$SHELLFISH_SESSION" || exit 1
tool=${body%%[[:space:]]*}

if [[ $tool == [+-]* ]]; then
  print -u2 -r -- "$usage"
  exit 0
elif [[ -n $tool ]] && ! jq -e --arg tool "$tool" '
    any(.profile.tools[]; split("/") | last == $tool)' <<<"$header" >/dev/null; then
  print -u2 -r -- "sandbox tool is not selected: $tool"
  exit 0
fi

if [[ $body == "$tool" ]]; then
  jq -r --arg tool "$tool" '.profile as $profile | $profile.sandbox as $sandbox |
    "Sandbox: " + (if $sandbox.enabled then "enabled" else "disabled" end),
    "Additional grants (tool policy still applies):",
    ($profile.tools[] | split("/") | last | select($tool == "" or . == $tool)) as $name |
      $name + ":",
      (("read", "write", "domains") as $access | ($sandbox.tools[$name][$access] // []) as $grants |
        "  \($access):", if $grants == [] then "    (none)" else $grants[] | "    " + . end)
  ' <<<"$header" >&2
  exit
fi

body=${body#"$tool"}
body=${body##[[:space:]]#}
operation=${body%%[[:space:]]*}
candidate=${body#"$operation"}
candidate=${candidate##[[:space:]]#}
candidate=${candidate%%[[:space:]]#}
case $operation in
  +read) action=add; access=read ;;
  +write) action=add; access=write ;;
  +domain) action=add; access=domains ;;
  -read) action=remove; access=read ;;
  -write) action=remove; access=write ;;
  -domain) action=remove; access=domains ;;
  *)
    print -u2 -r -- "$usage"
    exit 0
    ;;
esac
label=${access%s}
[[ -n $candidate ]] || {
  print -u2 -r -- "$usage"
  exit 0
}

jq -e '.profile.sandbox.enabled' <<<"$header" >/dev/null || {
  print -u2 -r -- 'session sandbox is disabled'
  exit 0
}
grants=$(jq -ce --arg tool "$tool" --arg access "$access" \
  '.profile.sandbox.tools[$tool][$access] // [] | select(type == "array")' \
  <<<"$header") || exit 1

if [[ $access == domains ]]; then
  jq -en --arg domain "$candidate" '
    $domain | (test("[[:cntrl:]]") | not) and
      test("^(\\*\\.)?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\\.)*[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$")
  ' >/dev/null || {
    print -u2 -r -- "sandbox domain must be a hostname or *.hostname: $candidate"
    exit 0
  }
  value=${candidate:l}
else
  if [[ $candidate == '~' || $candidate == '~/'* ]]; then
    [[ -n ${HOME-} ]] || {
      print -u2 -r -- 'cannot expand ~ without HOME'
      exit 0
    }
    candidate=${candidate/#\~/${HOME:A}}
  elif [[ $candidate == @* ]]; then
    candidate=$SHELLFISH_SHARE_DIR/${candidate#@}
  elif [[ $candidate != /* ]]; then
    candidate="$PWD/$candidate"
  fi

  value=${candidate:A}
  if [[ $action == add && ! -d $value ]]; then
    print -u2 -r -- "sandbox directory does not exist: $candidate"
    exit 0
  fi
fi

# Stored grants name HOME as "~/" and the bundled root as "@".
while IFS= read -r -d '' grant; do
  if [[ $access == domains ]]; then
    resolved=$grant
  else
    case $grant in
      '~/'*) resolved="${HOME:A}/${grant#\~/}" ;;
      @*) resolved=$SHELLFISH_SHARE_DIR/${grant#@} ;;
      *) resolved=$grant ;;
    esac
    resolved=${resolved:A}
  fi
  [[ $resolved != "$value" ]] || { matched=$grant; break; }
done < <(jq -jr '.[] | ., "\u0000"' <<<"$grants")

if [[ -n $matched ]]; then
  if [[ $action == add ]]; then
    print -u2 -r -- "sandbox $label grant already exists: $value"
    exit 0
  fi
elif [[ $action == remove ]]; then
  print -u2 -r -- "sandbox $label grant is not set: $value"
  exit 0
fi

updated=$(jq -c --arg action "$action" --arg value "$value" --arg matched "$matched" '
  if $action == "add" then . + [$value] else map(select(. != $matched)) end
' <<<"$grants") || exit 1
profile=$(jq -c --arg tool "$tool" --arg access "$access" --argjson grants "$updated" '
  .profile | .sandbox.tools[$tool] //= {read:[], write:[], domains:[]} |
  .sandbox.tools[$tool][$access]=$grants
' <<<"$header") || exit 1
if [[ $action == add ]]; then
  message="The user added a session sandbox $label grant for $tool: $value"
  user="**Sandbox** $tool $label grant added"
else
  message="The user removed a session sandbox $label grant for $tool: $value"
  user="**Sandbox** $tool $label grant removed"
fi
jq -cn --argjson profile "$profile" '{action:"session_update",profile:$profile}' >&3 || exit 1
print -rn -- "$message"
print -rnu2 -- "$user"$'\n'"$value"

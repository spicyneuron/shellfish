#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_multios pipe_fail

typeset command output
integer command_status
command=$(cat) || exit 1
if [[ -z $command ]]; then
  source "$SHELLFISH_SHARE_DIR/lib/command-usage.zsh" || exit 1
  sf_command_usage user_shell
  exit $?
fi

output=$(
  unset SHELLFISH_SESSION SHELLFISH_TURN_STATE
  unset SHELLFISH_MAX_CAPTURE_KB SHELLFISH_MODE SHELLFISH_MODEL SHELLFISH_TURN_ID SHELLFISH_VERBOSE
  unset SHELLFISH_DIR
  command zsh -f -c "$command" </dev/null 2>&1 3>&-
  command_status=$?
  (( ! command_status )) || print -r -- $'\n(exit '"$command_status"')'
)
print -ru2 -- "**Shell** $command"$'\n'"$output"
print -rn -- "The user ran this shell command:"$'\n'"\$ $command"$'\n'"$output"

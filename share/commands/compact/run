#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

source "${0:A:h:h:h}/lib/compact.zsh" || exit 1

typeset draft='' steering='' instruction request summary split transcript

# The autocompact hook passes --auto with the submitted prompt, kept as the draft.
if [[ ${1-} == --auto ]]; then
  jq -es '
    .[0].model.context_window as $window |
    ([.[] | select(.type == "assistant" and .usage != null)] | last) as $measured |
    $window != null and $measured != null and
    (($measured.usage.input_tokens + $measured.usage.output_tokens) / $window) >= 0.8
  ' "$SHELLFISH_SESSION" >/dev/null 2>&1 || exit 0
  draft=$(cat; printf x)
  draft=${draft%x}
else
  steering=$(cat; printf x)
  steering=${steering%x}
fi

split=$(sf_compact_split) || {
  sf_compact_fail 'Nothing to compact yet.'
}
jq -e '.cut > .start' <<<"$split" >/dev/null ||
  sf_compact_fail 'Nothing older than the protected recent context to compact.'

[[ -r ${0:A:h}/prompt.md ]] && instruction=$(<"${0:A:h}/prompt.md") || {
  sf_compact_fail 'Could not read compaction prompt. Original session kept.'
}
request=$(jq -cs --arg text "$instruction" --arg steering "$steering" --argjson split "$split" \
  '
  [.[$split.cut:][] | select(.type == "user")] as $recent |
  {type:"user",content:[{type:"text",text:($text +
    "\n\nRetained prompts: \($recent | length)" +
    "\nFirst retained prompt, JSON-quoted excerpt: " +
    ($recent[0].content[0].text[:512] | tojson) +
    (if $steering == "" then "" else
      "\n\nUser instructions for this summary:\n" + $steering end))}]}
  ' "$SHELLFISH_SESSION") || {
  sf_compact_fail 'Could not prepare summary request. Original session kept.'
}
summary=$({ cat -- "$SHELLFISH_SESSION"; print -r -- "$request"; } |
  "$SHELLFISH_EXECUTABLE" request |
  jq -er 'select(.stop == "end") | [.content[] | select(.type == "text") | .text] | join("") |
    select(test("[^[:space:]]"))') || {
  sf_compact_fail 'Could not summarize session. Original session kept.'
}

transcript="$SHELLFISH_TURN_STATE/compact.jsonl"
# Keep prefix state updates once, then retain the suffix in its original order.
if ! jq -ce -s --argjson split "$split" --arg summary "$summary" '
    . as $records |
    # The suffix keeps hook IDs, so allocate beyond every source hook.
    (([$records[] | select(.type == "hook_result") | .id | tonumber] | max // 0) + 1 |
      tostring) as $id |
    ([$records[] | select(.type == "state_update" and .name == "compact/first_user")] |
      last) as $saved |
    ($saved.value // ([$records[] | select(.type == "user")][0].content[0].text)) as $first |
    ("Earlier conversation was compacted. The original request and summary below are " +
      "background. Everything after this block is verbatim and takes precedence.\n\n" +
      "<original_request>\n" + $first + "\n</original_request>\n\n" +
      "<summary>\n" + $summary + "\n</summary>") as $context |
    ($records[:$split.start][]),
    ($records[$split.start:$split.cut][] | select(.type == "state_update")),
    (if $saved == null then
      {type:"state_update",name:"compact/first_user",value:$first} else empty end),
    {type:"hook_result",lifecycle:"user_prompt_submit",id:$id,
      user_text:("**Compacted conversation**\n" + $summary),
      model_text:("<context script=\"compact\">\n" + $context + "\n</context>")},
    $records[$split.cut:][]
  ' "$SHELLFISH_SESSION" >"$transcript"; then
  sf_compact_fail 'Could not create compacted session. Original session kept.'
fi

sf_compact_handoff "$transcript" compact "$draft" || {
  sf_compact_fail 'Could not create compacted session. Original session kept.'
}
exit 0

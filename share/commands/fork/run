#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset target base candidate created draft='' resolved name=fork
typeset transcript
typeset -a argv fields
integer suffix=1 cutoff=0 has_draft=0 rewind=0
# /rewind truncates this session in place, defaulting to its last user section.
[[ ${1-} != --rewind ]] || { rewind=1; name=rewind }
target=$(cat)
if [[ -n $target && ( $target != <1-> || ${#target} -gt 9 ) ]]; then
  print -ru2 -- "Usage: /$name [N]"
  exit 0
fi
target=${target:-0}

resolved=$(jq -j -s --argjson target "$target" --argjson rewind "$rewind" '
  . as $records |
  (reduce ($records | to_entries[] |
      select(.value.type == "user" or .value.type == "assistant")) as $entry
    ([];
      if $entry.value.type == "user" then
        . + [{type:"user",index:$entry.key,draft:$entry.value.content[0].text}]
      elif length == 0 or .[-1].type != "assistant" then
        . + [{type:"assistant"}]
      else . end)) as $sections |
  if ($sections | any(.type == "user") | not) then error("empty")
  elif $target == 0 and $rewind == 1 then
    ([$sections[] | select(.type == "user")] | last | [.index, .draft, 1])
  elif $target == 0 then [($records | length), "", 0]
  elif $target >($sections | length) then error("missing")
  elif $sections[$target - 1].type == "user" then
    ($sections[$target - 1] | [.index, .draft, 1])
  else ([$sections[$target:][] | select(.type == "user")] | first) as $next |
    if $next == null then [($records | length), "", 0]
    else [$next.index, $next.draft, 1] end
  end | "\(.[0])\u0000\(.[1])\u0000\(.[2])\u0000"
' "$SHELLFISH_SESSION" 2>/dev/null) || {
  print -ru2 -- "${(C)name} target does not exist."
  exit 0
}
fields=( "${(@0)${resolved%$'\0'}}" )
(( ${#fields} == 3 )) || exit 1
cutoff=$fields[1]
draft=$fields[2]
has_draft=$fields[3]

if (( rewind )); then
  # Later state updates stay, so running subagents remain attached. The turn
  # holds the session lock, so no writer races the replacement.
  (( has_draft )) || { print -ru2 -- 'Nothing to rewind.'; exit 0 }
  transcript=$(mktemp "${SHELLFISH_SESSION:h}/.${SHELLFISH_SESSION:t}.XXXXXX") || exit 1
  if ! { chmod 600 "$transcript" &&
      jq -ce -s --argjson cutoff "$cutoff" '
        .[0:$cutoff][], (.[$cutoff:][] | select(.type == "state_update"))
      ' "$SHELLFISH_SESSION" >"$transcript" &&
      mv -f -- "$transcript" "$SHELLFISH_SESSION"; }; then
    rm -f -- "$transcript"
    print -ru2 -- 'Could not rewind session.'
    exit 0
  fi
  argv=( "$SHELLFISH_EXECUTABLE" --session "$SHELLFISH_SESSION" --draft "$draft" )
  jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
  exit 0
fi

created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || exit 1
transcript="$SHELLFISH_TURN_STATE/fork.jsonl"
if ! jq -ce -s --argjson cutoff "$cutoff" --arg created "$created" '
  .[0:$cutoff] | .[0].created = $created | .[]
' "$SHELLFISH_SESSION" >"$transcript"; then
  print -ru2 -- 'Could not fork session.'
  exit 0
fi

base=${SHELLFISH_SESSION%.jsonl}
base=${base%_fork(|_<->)}
base="${base}_fork"
while true; do
  candidate="${base}_${suffix}.jsonl"
  if (umask 077; setopt no_clobber; cat -- "$transcript" >"$candidate") 2>/dev/null; then
    break
  fi
  if [[ ! -e $candidate && ! -L $candidate ]]; then
    print -ru2 -- "Could not create fork:"$'\n'"$candidate"
    exit 0
  fi
  (( suffix++ ))
done

argv=( "$SHELLFISH_EXECUTABLE" --session "$candidate" )
(( ! has_draft )) || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
exit 0

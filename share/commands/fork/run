#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_multios pipe_fail

typeset target base candidate created='' draft='' resolved name=fork
typeset transcript
typeset -a argv fields
integer suffix=1 cutoff=0 has_draft=0 rewind=0
# /rewind truncates this session in place, defaulting to its last user section.
[[ ${1-} != --rewind ]] || { rewind=1; name=rewind }
target=$(cat)
if [[ -n $target && ( $target != <1-> || ${#target} -gt 9 ) ]]; then
  print -ru2 -- "Usage: /$name [N]"
  exit 0
fi
target=${target:-0}

# The cut restores the moment before the prompt was sent: notices that awaited
# it stay, and output from hooks that ran on its submission goes.
resolved=$(jq -j -s -L "${0:A:h:h:h}/lib" --argjson target "$target" --argjson rewind "$rewind" '
  include "sections";
  . as $records |
  def cut:
    if .prompt == null then [($records | length), "", 0]
    else .prompt as $prompt |
      [($prompt | until(. <= 1 or ($records[. - 1] |
          .type != "hook_result" or .lifecycle != "user_prompt_submit" or
          .action == "deny"); . - 1)),
       $records[$prompt].content[0].text, 1]
    end;
  sections as $sections |
  ([$sections[] | select(.role == "user")]) as $users |
  if $users == [] then error("empty")
  elif $target == 0 and $rewind == 1 then
    ([$users[] | select(.prompt != null)] | last // {prompt:null}) | cut
  elif $target == 0 then [($records | length), "", 0]
  elif $target > ($sections | length) then error("missing")
  else (first($sections[$target - 1:][] | select(.role == "user")) // {prompt:null}) | cut
  end | "\(.[0])\u0000\(.[1])\u0000\(.[2])\u0000"
' "$SHELLFISH_SESSION" 2>/dev/null) || {
  print -ru2 -- "${(C)name} target does not exist."
  exit 0
}
fields=( "${(@0)${resolved%$'\0'}}" )
(( ${#fields} == 3 )) || exit 1
cutoff=$fields[1]
draft=$fields[2]
has_draft=$fields[3]

if (( rewind )); then
  (( has_draft )) || { print -ru2 -- 'Nothing to rewind.'; exit 0 }
  transcript=$(mktemp "${SHELLFISH_SESSION:h}/.${SHELLFISH_SESSION:t}.XXXXXX") || exit 1
  chmod 600 "$transcript" || { rm -f -- "$transcript"; exit 1 }
else
  created=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || exit 1
  transcript="$SHELLFISH_TURN_STATE/fork.jsonl"
fi

# Later updates refresh only state that exists at the cutoff, and state first
# set after it is left out.
if ! jq -ce -s --argjson cutoff "$cutoff" --arg created "$created" '
  ([.[0:$cutoff][] | select(.type == "state_update") | .name] | unique) as $names |
  (.[0:$cutoff] | if $created == "" then . else .[0].created = $created end | .[]),
  (.[$cutoff:][] | select(.type == "state_update" and IN(.name; $names[])))
' "$SHELLFISH_SESSION" >"$transcript"; then
  rm -f -- "$transcript"
  print -ru2 -- "Could not $name session."
  exit 0
fi

if (( rewind )); then
  # The turn holds the session lock, so no writer races the replacement.
  mv -f -- "$transcript" "$SHELLFISH_SESSION" || {
    rm -f -- "$transcript"
    print -ru2 -- 'Could not rewind session.'
    exit 0
  }
  candidate=$SHELLFISH_SESSION
else
  base=${SHELLFISH_SESSION%.jsonl}
  base=${base%_fork(|_<->)}
  base="${base}_fork"
  while true; do
    candidate="${base}_${suffix}.jsonl"
    if (umask 077; setopt no_clobber; cat -- "$transcript" >"$candidate") 2>/dev/null; then
      break
    fi
    if [[ ! -e $candidate && ! -L $candidate ]]; then
      print -ru2 -- "Could not create fork:"$'\n'"$candidate"
      exit 0
    fi
    (( suffix++ ))
  done
fi

argv=( "$SHELLFISH_EXECUTABLE" --session "$candidate" )
(( ! has_draft )) || argv+=( --draft "$draft" )
jq -cn '$ARGS.positional | {action:"handoff",argv:.}' --args -- "${argv[@]}" >&3 || exit 1
exit 0

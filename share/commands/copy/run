#!/usr/bin/env zsh

emulate -R zsh
setopt no_aliases no_multios pipe_fail

typeset target text copier
target=$(cat)
if [[ -n $target && ( $target != <1-> || ${#target} -gt 9 ) ]]; then
  print -u2 -r -- 'usage: /copy [N]'
  exit 0
fi
target=${target:-0}

text=$(jq -j -s -L "${0:A:h:h:h}/lib" --argjson target "$target" '
  include "sections";
  sections as $sections |
  # Without a target, skip trailing notices such as an earlier copy confirmation.
  (if $target == 0 then
     ([$sections | to_entries[] | select(.value.texts | any(. != "")) | .key + 1] | last // 0)
   else $target end) as $id |
  if $id < 1 or $id > ($sections | length) then error("section does not exist")
  else ($sections[$id - 1].texts | join("\n\n")) + "\u0000" end
' "$SHELLFISH_SESSION" 2>/dev/null) || {
  print -u2 -r -- 'copy target does not exist'
  exit 0
}
text=${text%$'\0'}
# A section holding only notices that await the next prompt has no text.
[[ -n $text ]] || { print -u2 -r -- 'Nothing to copy.'; exit 0 }

if (( $+commands[pbcopy] )); then
  copier=( pbcopy )
elif (( $+commands[wl-copy] )); then
  copier=( wl-copy )
elif (( $+commands[xclip] )); then
  copier=( xclip -selection clipboard )
elif (( $+commands[xsel] )); then
  copier=( xsel --clipboard --input )
else
  print -u2 -r -- 'cannot copy: no supported clipboard command found'
  exit 0
fi
print -rn -- "$text" | "${copier[@]}" || {
  print -u2 -r -- 'cannot copy to clipboard'
  exit 0
}
print -u2 -r -- 'Copied.'
exit 0

// Shellfish sandbox: https://github.com/spicyneuron/shellfish
//
// The profiles beside this one select this file as "default". Paths are
// absolute, "~/" for HOME, "./" or "../" relative to this file, or "@" for the
// bundled root, and need not exist on every machine.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/sandbox.schema.json",

  // false runs every tool with user permissions.
  // "enabled": true,

  "read": [
    // Paths outside the project that sandboxed tools may read
  ],
  "write": [
    // Paths outside the project that sandboxed tools may read and write
  ]
}

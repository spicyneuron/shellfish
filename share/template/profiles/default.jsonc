// Shellfish profile: https://github.com/spicyneuron/shellfish
//
// Selected when --profile is absent. A profile selects sandbox files, system
// prompts, tools, commands, and hooks, with optional config. The model is chosen
// separately.
// A name resolves in this Shellfish directory first, then the bundled one.
// A path starts with "/", "~/", "./", "../", or "@" for the bundled root.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/profile.schema.json",

  // Files under sandbox/. Lists merge left to right.
  "sandbox": "default",

  // Files under system/ concatenated into the system prompt.
  "system": ["general.md", "tools.md"],

  // Tools available to the model. Add the subagent tool to delegate tasks.
  "tools": ["read_file", "edit_file", "write_file", "shell", "search_web", "fetch_url", "skill"],

  // Commands typed as /NAME, which run instead of submitting the prompt.
  "commands": ["help", "verbose", "new", "resume", "fork", "rewind", "compact", "copy", "user_shell", "sandbox", "server"],

  // Hooks run in this order within the lifecycle their manifest names. Add
  // "sandbox/approver" to have a model review sandbox bypass requests.
  "hooks": [
    "project/environment", "git/environment", "project/instructions", "skills/list",
    "autocompact", "git/identity", "skills/mention"
  ]
}

// The default agent with read-only tools. Select with --profile readonly.
{
  "$schema": "https://raw.githubusercontent.com/spicyneuron/shellfish/refs/heads/main/share/profile.schema.json",

  "sandbox": "default",
  "system": ["readonly.md", "tools.md"],
  "tools": ["read_file", "shell_readonly"],
  "commands": ["help", "verbose", "new", "resume", "fork", "rewind", "compact", "copy", "user_shell", "sandbox"],
  "hooks": [
    "project/instructions",
    "autocompact", "git/identity", "skills/mention"
  ]
}

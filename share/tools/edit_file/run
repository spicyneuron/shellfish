#!/usr/bin/env zsh
set -euo pipefail
decoded=$(jq -ejr '
  def field: ., "\u0000";
  def string: type == "string" and index("\u0000") == null;
  select(type == "object" and (.file_path | string and length > 0) and
    (.old_string | string and length > 0) and (.new_string | string) and
    ((has("replace_all") | not) or (.replace_all | type == "boolean")) and
    (keys - ["file_path", "new_string", "old_string", "replace_all"] | length == 0)) |
  (.file_path | field), (.old_string | field), (.new_string | field),
  ((.replace_all // false) | tostring | field), ("ok" | field)
') || { printf 'edit_file: invalid input\n'; exit 2; }
fields=( "${(@0)${decoded%$'\0'}}" )
(( ${#fields} == 5 )) && [[ $fields[5] == ok ]] || {
  printf 'edit_file: invalid input\n'
  exit 2
}
file_path=$fields[1]
old_string=$fields[2]
new_string=$fields[3]
replace_all=$fields[4]

[[ -e $file_path || -L $file_path ]] || { printf 'edit_file: no such file: %s\n' "$file_path"; exit 2; }
[[ ! -d $file_path ]] || { printf 'edit_file: %s is a directory\n' "$file_path"; exit 2; }
[[ -f $file_path ]] || { printf 'edit_file: not a regular file: %s\n' "$file_path"; exit 2; }
[[ -r $file_path && -w $file_path ]] || { printf 'edit_file: cannot write %s\n' "$file_path"; exit 2; }
probe_bytes=$(wc -c <"$file_path")
text_bytes=$(tr -d '\0' <"$file_path" | wc -c)
((probe_bytes == text_bytes)) || { printf 'edit_file: %s is not a text file\n' "$file_path"; exit 2; }
original=$(cat -- "$file_path"; printf X); original=${original%X}

count_matches() {
  local remainder=$original
  matches=0
  while [[ $remainder == *${~pattern}* ]]; do
    remainder=${remainder#*${~pattern}}
    ((matches += 1))
  done
}
pattern=${(b)old_string}
count_matches
if ((matches == 0)); then
  # Retry with the file's CRLF line endings and either quote style.
  if [[ $original == *$'\r\n'* && $old_string != *$'\r'* ]]; then
    old_string=${old_string//$'\n'/$'\r\n'}
    new_string=${new_string//$'\n'/$'\r\n'}
  fi
  pattern=${(b)old_string}
  for quote in ‘ ’; do pattern=${pattern//$quote/\'}; done
  for quote in “ ”; do pattern=${pattern//$quote/\"}; done
  pattern=${${pattern//\'/(\'|‘|’)}//\"/(\"|“|”)}
  count_matches
fi
case $matches in
  0) printf 'edit_file: old_string does not appear in %s\n' "$file_path"; exit 2 ;;
  1) updated=${original/${~pattern}/$new_string} ;;
  *)
    if [[ $replace_all == true ]]; then
      updated=${original//${~pattern}/$new_string}
    else
      printf 'edit_file: old_string appears %d times in %s; include more surrounding context or set replace_all\n' \
        "$matches" "$file_path"
      exit 2
    fi
    ;;
esac
if [[ $updated == "$original" ]]; then
  printf 'edit_file: %s is already up to date\n' "$file_path"
  exit 0
fi
snapshot=$(mktemp "${TMPDIR:-/tmp}/shellfish-edit-original.XXXXXX") || {
  printf 'edit_file: cannot prepare diff for %s\n' "$file_path"
  exit 2
}
diff_file=$(mktemp "${TMPDIR:-/tmp}/shellfish-edit-diff.XXXXXX") || {
  rm -f -- "$snapshot"
  printf 'edit_file: cannot prepare diff for %s\n' "$file_path"
  exit 2
}
trap 'rm -f -- "$snapshot" "$diff_file"' EXIT
cp -- "$file_path" "$snapshot" || {
  printf 'edit_file: cannot prepare diff for %s\n' "$file_path"
  exit 2
}
printf '%s' "$updated" >"$file_path" || {
  printf 'edit_file: cannot write %s\n' "$file_path"
  exit 2
}
if diff -U1 -L '' -L '' -- "$snapshot" "$file_path" >"$diff_file"; then
  diff_status=0
else
  diff_status=$?
fi
((diff_status == 1)) || {
  printf 'edit_file: cannot render diff for %s\n' "$file_path"
  exit 2
}
awk '
  NR == 1 && /^--- / { next }
  NR == 2 && /^\+\+\+ / { next }
  { print }
' "$diff_file"

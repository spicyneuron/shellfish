#!/usr/bin/env zsh
set -euo pipefail

decoded=$(jq -ejr '
  def field: ., "\u0000";
  def string: type == "string" and length > 0 and index("\u0000") == null;
  select(type == "object" and (.file_path | string) and
    ((.offset // 1) | type == "number" and floor == . and . >= 1) and
    ((.limit // 500) | type == "number" and floor == . and . >= 1) and
    (keys - ["file_path", "limit", "offset"] | length == 0)) |
  (.file_path | field), ((.offset // 1) | tostring | field),
  ((.limit // 500) | tostring | field), ("ok" | field)
') || { printf 'read_file: invalid input\n'; exit 2; }
fields=( "${(@0)${decoded%$'\0'}}" )
(( ${#fields} == 4 )) && [[ $fields[4] == ok ]] || {
  printf 'read_file: invalid input\n'
  exit 2
}
file_path=$fields[1]
offset=$fields[2]
limit=$fields[3]

[[ -e $file_path ]] || { printf 'read_file: no such file: %s\n' "$file_path"; exit 2; }
[[ ! -d $file_path ]] || { printf 'read_file: %s is a directory\n' "$file_path"; exit 2; }
[[ -f $file_path ]] || { printf 'read_file: not a regular file: %s\n' "$file_path"; exit 2; }
[[ -r $file_path ]] || { printf 'read_file: cannot read %s\n' "$file_path"; exit 2; }

# An image returns as content for the model to view, re-encoded in the
# configured format and its long edge downscaled to fit vision limits.
image_format() {
  case $(head -c 12 -- "$1" | od -An -tx1 | tr -d ' \n') in
    (89504e470d0a1a0a*) REPLY=png ;;
    (ffd8ff*) REPLY=jpeg ;;
    (47494638*) REPLY=gif ;;
    (52494646????????57454250) REPLY=webp ;;
    (*) return 1 ;;
  esac
}

# ImageMagick leads because sips cannot write WebP.
if (( $+commands[magick] )); then resizer=magick
elif (( $+commands[identify] && $+commands[convert] )); then resizer=convert
elif (( $+commands[sips] )); then resizer=sips
else resizer=''
fi

# WIDTH HEIGHT of an image's first frame, or nothing when it cannot be decoded.
image_size() {
  case $resizer in
    (sips) sips -g pixelWidth -g pixelHeight "$1" 2>/dev/null |
      awk '/pixelWidth/ { w = $2 } /pixelHeight/ { h = $2 } END { if (w && h) print w, h }' ;;
    (magick) magick identify -format '%w %h' "${1}[0]" 2>/dev/null ;;
    (convert) identify -format '%w %h' "${1}[0]" 2>/dev/null ;;
  esac
}

if image_format "$file_path"; then
  source_format=$REPLY image=$file_path max_edge=1568 note=''
  settings=$(jq -r '
    .read_file // {} |
    if type == "object" and (keys - ["image_format", "image_quality"]) == [] then
      "\(.image_format // "webp") \(.image_quality // 75)"
    else error end
  ' <<<"${SHELLFISH_CONFIG:-{\}}" 2>/dev/null) || settings=''
  read -r format quality <<<"$settings"
  integer width=0 height=0 bytes limit=${SHELLFISH_MAX_CONTENT_BYTES:-5242880}
  typeset -a flags=()
  [[ $format == (webp|jpeg|png) && $quality == <1-100> ]] || {
    printf 'read_file: config.read_file allows image_format webp, jpeg, or png and image_quality from 1 to 100\n'
    exit 2
  }
  # Neither resizer takes --, so a leading dash must not read as an option.
  [[ $image != -* ]] || image=./$image
  # A stored image the API rejects would fail every later request, so one that
  # cannot be decoded, or checked at all, is refused.
  [[ -n $resizer ]] || {
    printf 'read_file: viewing %s needs sips or ImageMagick to check it\n' "$file_path"
    exit 2
  }
  size=$(image_size "$image") || true
  [[ $size == <->' '<-> ]] || { printf 'read_file: cannot decode image %s\n' "$file_path"; exit 2; }
  read -r width height <<<"$size"
  if (( width > max_edge || height > max_edge )); then
    note=", downscaled from ${width}x$height"
    [[ $resizer == sips ]] && flags=( -Z $max_edge ) || flags=( -resize ${max_edge}x$max_edge )
  fi
  # An image already in the format and size it needs is sent as is. Otherwise
  # it is re-encoded, keeping a GIF's first frame.
  if [[ $source_format != $format || -n $note ]]; then
    [[ $resizer != sips || $format != webp ]] || format=jpeg
    if [[ $format != png ]]; then
      [[ $resizer == sips ]] && flags+=( -s formatOptions $quality ) || flags+=( -quality $quality )
    fi
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/read_file.XXXXXX")
    trap 'rm -rf -- "$scratch"' EXIT
    case $resizer in
      (sips) sips "${flags[@]}" -s format $format "$image" --out "$scratch/image" >/dev/null 2>&1 ;;
      (magick) magick "${image}[0]" "${flags[@]}" "$format:$scratch/image" 2>/dev/null ;;
      (convert) convert "${image}[0]" "${flags[@]}" "$format:$scratch/image" 2>/dev/null ;;
    esac || { printf 'read_file: cannot encode %s as %s\n' "$file_path" "$format"; exit 2; }
    image=$scratch/image
    read -r width height <<<"$(image_size "$image")" || true
  fi
  bytes=$(wc -c <"$image")
  # Base64 grows by a third, plus the control line around it.
  (( (bytes + 2) / 3 * 4 + 128 <= limit )) || {
    printf 'read_file: %s is too large to view (%d bytes)\n' "$file_path" "$bytes"
    exit 2
  }
  printf '[image %dx%d %s%s]\n' $width $height "$format" "$note"
  printf '{"content":[{"type":"image","url":"data:image/%s;base64,%s"}]}\n' \
    "$format" "$(base64 <"$image" | tr -d '\n')" >&3
  exit
fi

budget=$((${SHELLFISH_MAX_CAPTURE_BYTES:-32768} - 512 - ${#file_path}))
((budget > 0)) || { printf 'read_file: read budget is too small\n'; exit 2; }
probe_bytes=$(head -c 8000 -- "$file_path" | wc -c)
text_bytes=$(head -c 8000 -- "$file_path" | tr -d '\0' | wc -c)
((probe_bytes == text_bytes)) || { printf 'read_file: %s appears to be binary\n' "$file_path"; exit 2; }

READ_FILE_PATH=$file_path awk -v start="$offset" -v max="$limit" -v budget="$budget" '
  BEGIN { path = ENVIRON["READ_FILE_PATH"] }
  {
    if (NR < start || stopped) next
    if (emitted >= max) { reason = "limit"; stopped = 1; next }
    line = sprintf("%d\t%s", NR, $0); size = length(line) + 1
    if (used + size > budget) {
      if (emitted == 0) { over_line = NR; over_size = length($0); stopped = 1; next }
      reason = "the byte budget"; stopped = 1; next
    }
    buf[++emitted] = line; used += size
  }
  END {
    if (over_line) {
      printf "read_file: line %d of %s is %d bytes and does not fit the %d byte read budget; use shell to slice it\n", over_line, path, over_size, budget
      exit 2
    }
    if (NR == 0) { print "(empty)"; exit }
    if (start > NR) {
      printf "read_file: %s has %d lines; offset %d is past the end\n", path, NR, start
      exit 2
    }
    suffix = reason == "the byte budget" ? ", byte-limited" : ""
    printf "L%d-%d of %d%s\n", start, start + emitted - 1, NR, suffix
    for (i = 1; i <= emitted; i++) print buf[i]
  }
' <"$file_path"

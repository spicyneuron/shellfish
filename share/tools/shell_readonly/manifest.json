{
  "description": "Run one zsh command in the session working directory and return its combined output. Read only.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command"],
    "properties": {
      "command": {"type": "string", "minLength": 1},
      "timeout": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 120,
        "description": "Timeout in seconds"
      }
    }
  },
  "user_text": "Running read-only shell command:\n${input.command}",
  "user_text_done": "Ran read-only shell command:\n${input.command}\n${output.stdout}${output.stderr}",
  "user_text_skipped": "Did not run read-only shell command:\n${input.command}\n${output.stderr}",
  "user_permission": "${input.command}",
  "sandbox": true
}

{
  "description": "Run one zsh command in the session working directory and return its combined stdout and stderr, followed by an `exit N` line.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command"],
    "properties": {
      "command": {"type": "string", "minLength": 1, "description": "zsh command to run"},
      "timeout": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 120,
        "description": "Timeout in seconds"
      }
    }
  },
  "user_text": "**Shell** ${input.command}\n${output.stdout}",
  "sandbox": true,
  "allow_sandbox_bypass": true
}

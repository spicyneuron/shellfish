#!/usr/bin/env zsh

emulate -R zsh
setopt extended_glob no_aliases no_bg_nice no_multios pipe_fail

typeset input operation profile model task agent_id child parent_dir output owned fork transcript background working id
typeset header settings limit self=${0:h:t}
integer count=0 result=0

fail() { print -r -- "subagent: $1"; exit ${2:-1}; }

# Succeeds while a process holds the session's turn lock.
running() {
  local fd
  [[ -f $1.lock ]] || return 1
  zsystem flock -t 0 -f fd "$1.lock" 2>/dev/null || return 0
  zsystem flock -u "$fd"
  return 1
}

# Read the latest turn's outcome, then apply the caller's output shape.
read_outcome() {
  local body=$1
  shift
  jq -c -s --arg id "$agent_id" "$@" '
    if length < 2 or .[0].type != "session" or
       (any(.[1:][]; . == {type:"state_update",name:"subagent",value:true}) | not) or
       (all(.[]; .type | IN("session","state_update","hook_result","user",
         "assistant","tool_result","error")) | not) then
      error("invalid subagent session")
    else
      ([to_entries[] | select(.value.type == "user" or
        .value == {type:"state_update",name:"subagent",value:true}) | .key] | last) as $turn |
      .[$turn:] as $records |
      reduce $records[] as $record
        ({settled:false,answer:null};
         if $record.type == "error" then {settled:true,answer:null}
         elif $record.type == "assistant" then
           {settled:($record.stop == "end"),
            answer:(if $record.stop == "end" then
              [$record.content[] | select(.type == "text") | .text] | join("\n")
              else null end)}
         elif $record.type == "hook_result" and
              $record.lifecycle == "stop" and $record.action == "deny" then
           {settled:false,answer:null}
         else . end) |
      . + {agent_id:$id,last_record:$records[-1].type}
    end |
  '"$body" "$child"
}

# Removes this tool from a session header, since subagents cannot delegate.
typeset detach='if .type == "session" then
  .profile.tools |= map(select(split("/") | last != $self)) else . end'

input=$(cat) || fail 'cannot read input'
zmodload zsh/system || fail 'cannot load session locking'
# Profile and model names must be configured names, so neither can be a path
# to a file the model wrote.
operation=$(jq -er '
  def name: type == "string" and length > 0;
  select(type == "object" and
    ((keys - ["operation", "profile", "model", "fork", "task", "agent_id", "background"]) | length == 0)) |
  if .operation == "list" and keys == ["operation"] then "list"
  elif .operation == "start" and
     (((has("fork") | not) and
       (if has("profile") then .profile | name else true end) and
       (if has("model") then .model | name else true end)) or
      (has("fork") and (has("profile") | not) and (has("model") | not) and .fork == true)) and
     (.task | type == "string" and length > 0) and
     (if has("background") then .background | type == "boolean" else true end) and
     (has("agent_id") | not) then "start"
  elif (.operation == "inspect" or .operation == "continue") and
       (.agent_id | type == "string" and test("^[a-f0-9]{32}$")) and
       (has("profile") | not) and (has("model") | not) and (has("fork") | not) and
       (if .operation == "continue" then
         (.task | type == "string" and length > 0) and
         (if has("background") then .background | type == "boolean" else true end)
       else (has("task") | not) and (has("background") | not) end) then .operation
  else empty end
' <<<"$input" 2>/dev/null) || fail 'invalid input' 2

[[ -n ${SHELLFISH_SESSION-} && -n ${SHELLFISH_EXECUTABLE-} ]] ||
  fail 'session environment is unavailable'
IFS= read -r header <"$SHELLFISH_SESSION" || fail 'cannot read parent header'
settings=$(jq -ce '
  def choices: type == "object" and all(to_entries[];
    (.key | test("^[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*$")) and
    (.value | type == "string" and length > 0));
  if has("subagent") then .subagent else {} end |
  if type == "object" and (keys - ["max_active", "models", "profiles"]) == [] then .
  else error("config.subagent must be an object containing only max_active, profiles, and models") end |
  {max_active:(if has("max_active") then .max_active else 4 end),
   profiles:(.profiles // {}), models:(.models // {})} |
  if .max_active | type == "number" and floor == . and . > 0 then .
  else error("config.subagent.max_active must be a positive integer") end |
  if (.profiles | choices) and (.models | choices) then .
  else error("config.subagent.profiles and config.subagent.models must map names to descriptions") end
' <<<"${SHELLFISH_CONFIG:-{\}}") || fail 'invalid subagent configuration' 2
limit=$(jq -r '.max_active' <<<"$settings")
parent_dir=${SHELLFISH_SESSION:A:h}

if [[ $operation == list ]]; then
  jq -c '{profiles, models}' <<<"$settings"
  exit 0
fi

# The marker is feature-owned state, appended only after session_start settles.
if jq -e 'select(.type == "state_update" and .name == "subagent")' \
    "$SHELLFISH_SESSION" >/dev/null 2>&1; then
  fail 'a subagent cannot delegate'
fi

if [[ $operation == inspect || $operation == continue ]]; then
  agent_id=$(jq -r '.agent_id' <<<"$input")
else
  fork=$(jq -r '.fork // false' <<<"$input")
  background=$(jq -r '.background // false' <<<"$input")
  if [[ $fork != true ]]; then
    profile=$(jq -r '.profile // empty' <<<"$input")
    [[ -z $profile ]] || jq -e --arg name "$profile" '.profiles | has($name)' <<<"$settings" >/dev/null ||
      fail "profile is not available: $profile" 2
    model=$(jq -r '.model // empty' <<<"$input")
    [[ -z $model ]] || jq -e --arg name "$model" '.models | has($name)' <<<"$settings" >/dev/null ||
      fail "model is not available: $model" 2
  fi
  task=$(jq -r '.task' <<<"$input")
  agent_id=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]') || fail 'cannot create subagent ID'
  [[ $agent_id == [a-f0-9]## ]] || fail 'cannot create subagent ID'
fi

child="$parent_dir/.subagent-$agent_id.jsonl"
if [[ $operation == inspect || $operation == continue ]]; then
  jq -e -s --arg name "subagents/$agent_id" \
    '[.[] | select(.type == "state_update" and .name == $name) | .value] | last == true' \
    "$SHELLFISH_SESSION" >/dev/null || fail 'unknown agent_id' 2
  [[ -f $child && ! -L $child ]] || fail 'subagent session is unavailable'
  [[ -f $child.lock && ! -L $child.lock && -w $child.lock ]] ||
    fail 'subagent session lock is unavailable'
  working=false
  running "$child" && working=true
  output=$(read_outcome '
    . + {working:$working,settled:(.settled and ($working | not))}
  ' --argjson working "$working") || fail 'cannot inspect subagent session'
  if [[ $operation == inspect ]]; then
    print -r -- "$output"
    exit 0
  fi
  [[ $working == false ]] || fail 'subagent prior turn is still running' 2
  background=$(jq -r '.background // false' <<<"$input")
  task=$(jq -r '.task' <<<"$input")
fi

# The limit counts owned subagents whose turn is running now.
owned=$(jq -r -s '
  [.[] | select(.type == "state_update" and (.name | startswith("subagents/"))) |
    {key:.name,value:.value}] | from_entries | to_entries[] |
  select(.value == true) | .key | ltrimstr("subagents/")
' "$SHELLFISH_SESSION") || fail 'cannot read parent state'
for id in ${(f)owned}; do
  running "$parent_dir/.subagent-$id.jsonl" && (( ++count ))
done
(( count < limit )) || fail "active subagent limit reached ($limit)"

if [[ $operation == start ]]; then
  # Reserve a unique hidden path before creating it through the public interface.
  [[ ! -e $child && ! -L $child ]] || fail 'subagent ID collision'
  if [[ $fork == true ]]; then
    # The last user starts the invoking turn. Nothing from that turn is inherited.
    transcript=$(mktemp "$parent_dir/.subagent-fork.XXXXXX") || fail 'cannot prepare fork'
    if ! jq -ce -s --arg self "$self" '
          if length == 0 or .[0].type != "session" then
            error("invalid parent session")
          else
            . as $records |
            ([$records | to_entries[] | select(.value.type == "user") | .key] | last) as $turn |
            $records[0:($turn // length)][] | '"$detach"'
          end
        ' "$SHELLFISH_SESSION" >"$transcript" 2>/dev/null; then
      rm -f -- "$transcript"
      fail 'cannot fork parent session'
    fi
    if ! ln "$transcript" "$child" 2>/dev/null; then
      rm -f -- "$transcript"
      fail 'cannot create subagent session'
    fi
    rm -f -- "$transcript"
  else
    # A fresh child keeps the parent's profile and model unless the call names
    # others. A frozen header profile resolves again as a profile.
    [[ -n $model ]] || model=$(jq -ce '.model | objects' <<<"$header") ||
      fail 'cannot read parent model'
    [[ -n $profile ]] || profile=$(jq -ce '.profile | objects' <<<"$header") ||
      fail 'cannot read parent profile'
    "$SHELLFISH_EXECUTABLE" run --session-create --session-out "$child" \
      --profile "$profile" --model "$model" >/dev/null || fail 'cannot create subagent session'
    transcript=$(mktemp "$parent_dir/.subagent-header.XXXXXX") || fail 'cannot prepare subagent session'
    if ! jq -c --arg self "$self" "$detach" "$child" >"$transcript" ||
        ! mv -f -- "$transcript" "$child"; then
      rm -f -- "$transcript"
      fail 'cannot prepare subagent session'
    fi
  fi
  print -r -- '{"type":"state_update","name":"subagent","value":true}' >>"$child" ||
    fail 'cannot mark child session'
  print -r -u3 -- "$(jq -cn --arg name "subagents/$agent_id" \
    '{state_update:[{name:$name,value:true}]}')" || fail 'cannot record subagent'
fi

if [[ $background == true ]]; then
  output=$("$SHELLFISH_EXECUTABLE" run --background --session "$child" -- "$task")
  result=$?
  (( ! result )) && [[ $output == "$child" ]] || fail 'cannot launch background subagent'
  print -r -- "$(jq -cn --arg id "$agent_id" '{agent_id:$id,working:true,settled:false}')"
  exit 0
fi

"$SHELLFISH_EXECUTABLE" run --session "$child" -- "$task" >/dev/null 2>&1
result=$?
output=$(read_outcome '{agent_id,exit_code:$exit_code,answer}' \
  --argjson exit_code "$result") || fail 'cannot read subagent result'
print -r -- "$output"
exit "$result"

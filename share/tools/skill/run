#!/usr/bin/env zsh
set -euo pipefail

name=$(jq -ejr 'select(type == "object" and keys == ["name"] and
  (.name | type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$") and length <= 64)) | .name') || {
  print -r -- 'skill: invalid input'
  exit 2
}
source "$SHELLFISH_SHARE_DIR/lib/skills.zsh" || exit 1
if sf_skills_load "$name"; then
  exit 0
elif (( $? == 2 )); then
  print -r -- "skill is not available: $name"
  exit 2
else
  exit 1
fi

#!/usr/bin/env zsh
set -euo pipefail

name=$(jq -ejr 'select(type == "object" and keys == ["name"] and
  (.name | type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$") and length <= 64)) | .name') || {
  print -u2 -r -- 'skill: invalid input'
  exit 2
}
bundled_root=${0:A:h:h:h}
source "$bundled_root/lib/skills.zsh" || exit 1
sf_skills_discover "$bundled_root" "${SHELLFISH_CONFIG_DIR-}" "$PWD"
integer index
for (( index = 1; index <= ${#reply}; index += 3 )); do
  [[ $reply[index] == $name ]] || continue
  sf_skills_body "$reply[index+2]" || exit 1
  sf_skills_wrap "$name" "${reply[index+2]:h}" "$REPLY"
  exit $?
done
print -u2 -r -- "skill is not available: $name"
exit 2

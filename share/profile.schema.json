{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shellfish profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sandbox": {
      "anyOf": [
        {"$ref": "#/$defs/sandbox"},
        {"type": "array", "items": {"$ref": "#/$defs/sandbox"}}
      ]
    },
    "system": {
      "type": "array",
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/reference"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {"text": {"type": "string"}}
          }
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
    },
    "sandbox": {
      "anyOf": [{"$ref": "#/$defs/reference"}, {"$ref": "sandbox.schema.json"}]
    }
  }
}

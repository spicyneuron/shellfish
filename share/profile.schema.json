{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shellfish profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "sandbox": {
      "$ref": "#/$defs/sandbox"
    },
    "system": {
      "type": "array",
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/reference"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {"text": {"type": "string"}}
          }
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "user_approval_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "tools": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read": {"$ref": "#/$defs/paths"},
              "write": {"$ref": "#/$defs/paths"},
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(\\*\\.)?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\\.)*[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$",
                  "not": {"pattern": "[\u0000-\u001f\u007f-\u009f]"}
                }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(/|~/|\\./|\\.\\./|@)[^\u0000-\u001f\u007f-\u009f]*$"
      }
    }
  }
}
